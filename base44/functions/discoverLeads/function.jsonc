{
  "name": "discoverLeads",
  "entry": "main.ts",
  "automations": [
    {
      "name": "Daily Lead Discovery & Enrichment",
      "description": "Automatically discover and enrich new leads daily at 8 AM. Adjust niche, location, and radius in function_args to customize.",
      "function_args": {
        "niche": "med spa",
        "city": "Phoenix",
        "state": "AZ",
        "radius": 25
      },
      "is_active": false,
      "type": "scheduled",
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "days",
      "repeat_interval": 1,
      "start_time": "15:00",
      "repeat_on_days": null,
      "repeat_on_day_of_month": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  ]
}