{
  "name": "sendOnboardingEmailSequence",
  "entry": "main.ts",
  "automations": [
    {
      "name": "Send Go-Live Confirmation Email on Client Active",
      "description": "Trigger activation email when Client status changes to 'Active'",
      "function_args": {
        "stage": "live",
        "client_id": "{{id}}",
        "email": "{{email}}",
        "business_name": "{{business_name}}",
        "owner_name": "{{full_name}}"
      },
      "is_active": true,
      "type": "entity",
      "entity_name": "Client",
      "event_types": [
        "update"
      ]
    },
    {
      "name": "Send Onboarding Email on OnboardingClient Creation",
      "description": "Trigger onboarding email sequence when OnboardingClient is created",
      "function_args": {
        "stage": "onboarding_started",
        "onboarding_client_id": "{{id}}",
        "email": "{{email}}",
        "business_name": "{{business_name}}",
        "owner_name": "{{owner_name}}",
        "industry": "{{industry}}"
      },
      "is_active": true,
      "type": "entity",
      "entity_name": "OnboardingClient",
      "event_types": [
        "create"
      ]
    },
    {
      "name": "Send Setup Guidance Email on Client Status Change",
      "description": "Trigger setup email when Client status changes to 'In Setup'",
      "function_args": {
        "stage": "setup_in_progress",
        "client_id": "{{id}}",
        "email": "{{email}}",
        "business_name": "{{business_name}}",
        "owner_name": "{{full_name}}"
      },
      "is_active": true,
      "type": "entity",
      "entity_name": "Client",
      "event_types": [
        "update"
      ]
    },
    {
      "name": "Send Onboarding Welcome Email on Order Payment",
      "description": "Trigger welcome email sequence when Order payment_status changes to 'paid'",
      "function_args": {
        "stage": "onboarding_started",
        "order_id": "{{id}}",
        "email": "{{customer_email}}",
        "business_name": "{{business_name}}",
        "owner_name": "{{customer_name}}"
      },
      "is_active": true,
      "type": "entity",
      "entity_name": "Order",
      "event_types": [
        "update"
      ]
    }
  ]
}