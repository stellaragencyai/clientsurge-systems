{
  "name": "stalledOnboardingAlert",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "description": "Every day at 9AM, check for clients stuck in onboarding for more than 5 days and email Nolan with the list and incomplete steps.",
      "ends_type": "never",
      "is_active": true,
      "name": "Stalled Onboarding Alert — Daily 9AM",
      "repeat_interval": 1,
      "repeat_unit": "days",
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "start_time": "16:00"
    }
  ]
}
