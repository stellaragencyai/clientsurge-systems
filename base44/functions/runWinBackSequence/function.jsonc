{
  "name": "runWinBackSequence",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "description": "Daily: scans for orders with canceled/past_due/failed payment status for 30+ days and sends a 3-step win-back email sequence (Day 30 special offer, Day 37 diagnostic call, Day 44 final CTA).",
      "ends_type": "never",
      "is_active": true,
      "name": "Win-Back Sequence — Daily Check",
      "repeat_interval": 1,
      "repeat_unit": "days",
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "start_time": "17:00"
    }
  ]
}
