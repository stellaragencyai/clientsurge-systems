{
  "name": "Send Setup Guidance Email on Client Status Change",
  "description": "Trigger setup email when Client status changes to 'In Setup'",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"In Setup\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Client"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_setup_guidance_email_on_client_status_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendOnboardingEmailSequence",
            "args": {
              "stage": "setup_in_progress",
              "client_id": "{{id}}",
              "email": "{{email}}",
              "business_name": "{{business_name}}",
              "owner_name": "{{full_name}}"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}