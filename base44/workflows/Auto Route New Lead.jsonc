{
  "name": "Auto Route New Lead",
  "description": "When a new Leads record is created, automatically assign it to the best available team member based on workload and lead category, then send an SMS notification.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Leads"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_route_new_lead",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "routeLead",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}