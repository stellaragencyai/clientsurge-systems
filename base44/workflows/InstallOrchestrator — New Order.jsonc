{
  "name": "InstallOrchestrator \u2014 New Order",
  "description": "Triggers installOrchestrator when an order is created. Sets up install OS and initial status.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "installorchestrator_new_order",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "installOrchestrator",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}