{
  "name": "SaaS Workflow Orchestration: Order to Onboarding",
  "description": "Orchestrate complete SaaS workflow when Order is paid: create Client, ClientProject, Subscription, and initialize ClientInstallationOS",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"payment_status\") != null) and (.trigger.data.payment_status == \"paid\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "saas_workflow_orchestration_order_to_onboarding",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "orchestrateOrderToOnboarding",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}