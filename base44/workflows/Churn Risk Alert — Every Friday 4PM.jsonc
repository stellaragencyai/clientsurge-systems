      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "churnRiskAlert",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
