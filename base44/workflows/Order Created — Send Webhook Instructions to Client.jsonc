{
  "name": "Order Created \u2014 Send Webhook Instructions to Client",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.payment_status == \"paid\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "order_created_send_webhook_instructions_to_client",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoSendWebhookInstructions",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}