{
  "name": "Voice Call Bad Outcome \u2192 Schedule 24h Follow-Up",
  "description": "USE CASE #2: When voice_call_outcome changes to no_answer/busy/failed, immediately sets next_follow_up_at = 24h from now so processVoiceCallFollowUps picks it up.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"voice_call_outcome\") != null) and (.trigger.data.voice_call_outcome == \"no_answer\" or .trigger.data.voice_call_outcome == \"busy\" or .trigger.data.voice_call_outcome == \"failed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Leads"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "voice_call_bad_outcome_schedule_24h_follow_up",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "receiveElevenLabsPostCallWebhook",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}