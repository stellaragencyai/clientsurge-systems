{
  "name": "Credentials Complete \u2192 Generate AI Templates",
  "description": "When client credentials are submitted, AI auto-generates all 4 personalized SMS/email templates. Task #578.",
  "trigger": {
    "condition": "${ ((.trigger.data.workflow_stage == \"credentials_complete\") and (.trigger.changed_fields | index(\"workflow_stage\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ClientInstallationOS"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "credentials_complete_generate_ai_templates",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateServiceTemplates",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}