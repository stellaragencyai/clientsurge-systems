{
  "name": "Website Lead Follow-Up Processor \u2014 Every 5 Minutes",
  "description": "Runs the 3-step website lead follow-up sequence (10min SMS, 1hr email, 24hr SMS) every 5 minutes for leads with no reply and no booking",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-04-28T11:56:29.826000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "website_lead_follow_up_processor_every_5_minutes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processWebsiteLeadFollowUps",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}