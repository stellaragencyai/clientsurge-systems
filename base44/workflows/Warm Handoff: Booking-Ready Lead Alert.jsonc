{
  "name": "Warm Handoff: Booking-Ready Lead Alert",
  "description": "When a lead's AI intent becomes booking_ready, pause AI and notify the human sales rep with a full brief",
  "trigger": {
    "condition": "${ ((.trigger.data.ai_intent == \"booking_ready\") and (.trigger.changed_fields | index(\"ai_intent\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Leads"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "warm_handoff_booking_ready_lead_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "warmHandoffNotification",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}