{
  "name": "New Lead Email Notification",
  "description": "When a new lead is created, send a full-detail email notification to the admin inbox via Resend.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Leads"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_lead_email_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendAdminLeadNotification",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}