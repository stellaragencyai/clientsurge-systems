{
  "name": "New Lead Created \u2192 Route + First SMS",
  "description": "Fires onLeadCreated when a new Leads record is created. Routes to industry agent, generates first industry-specific SMS, sends it via Twilio.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Leads"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_lead_created_route_first_sms",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onLeadCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}