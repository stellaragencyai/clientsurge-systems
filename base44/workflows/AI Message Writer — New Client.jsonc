{
  "name": "AI Message Writer \u2014 New Client",
  "description": "When a new OnboardingClient is created, auto-generate 6 personalized SMS messages using AI and save them to the client record.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "OnboardingClient"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_message_writer_new_client",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "aiMessageWriter",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}