{
  "name": "Auto Provision Twilio Number \u2014 New Client",
  "description": "When a new OnboardingClient is created, automatically purchase a local AZ phone number (480/602), save it to the client record, and email Nolan confirmation.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "OnboardingClient"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_provision_twilio_number_new_client",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoProvisionTwilioNumber",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}