{
  "name": "Social: Chiropractic \u2014 Weekly Content",
  "description": "Every Thursday 7am \u2014 generates Instagram, LinkedIn, and Blog content for chiropractic / PT industry",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 14 * * 4",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "social_chiropractic_weekly_content",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSocialContent",
            "args": {
              "industry": "chiropractic",
              "content_types": [
                "blog_post",
                "instagram",
                "linkedin"
              ]
            }
          },
          "then": "end"
        }
      }
    ]
  }
}