{
  "name": "Referral",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "referrer_client_id": {
      "type": "string",
      "title": "Referrer Client ID"
    },
    "referred_email": {
      "type": "string",
      "title": "Referred Email",
      "format": "email"
    },
    "status": {
      "type": "string",
      "title": "Referral Status",
      "enum": [
        "pending",
        "invited",
        "converted",
        "credited",
        "cancelled"
      ],
      "default": "pending"
    },
    "credit_amount": {
      "type": "number",
      "title": "Credit Amount",
      "default": 0
    }
  }
}
