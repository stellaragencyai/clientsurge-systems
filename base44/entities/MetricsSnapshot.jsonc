{
  "name": "MetricsSnapshot",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "snapshot_date": {
      "type": "string",
      "title": "Snapshot Date",
      "format": "date-time"
    },
    "leads_captured_total": {
      "type": "number",
      "title": "Total Leads Captured",
      "default": 0
    },
    "leads_captured_this_period": {
      "type": "number",
      "title": "Leads Captured This Period (24h)",
      "default": 0
    },
    "leads_responded": {
      "type": "number",
      "title": "Leads Responded",
      "default": 0
    },
    "automations_active": {
      "type": "number",
      "title": "Active Automations",
      "default": 0
    },
    "automations_triggered_today": {
      "type": "number",
      "title": "Automations Triggered Today",
      "default": 0
    },
    "sms_sent_count": {
      "type": "number",
      "title": "SMS Messages Sent",
      "default": 0
    },
    "emails_sent_count": {
      "type": "number",
      "title": "Emails Sent",
      "default": 0
    },
    "bookings_created_total": {
      "type": "number",
      "title": "Total Bookings Created",
      "default": 0
    },
    "bookings_created_today": {
      "type": "number",
      "title": "Bookings Created Today",
      "default": 0
    },
    "system_health_status": {
      "type": "string",
      "title": "System Health Status",
      "enum": [
        "healthy",
        "degraded",
        "error"
      ],
      "default": "healthy"
    },
    "integrations_healthy": {
      "type": "array",
      "title": "Healthy Integrations",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "integrations_failed": {
      "type": "array",
      "title": "Failed Integrations",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "service_statuses": {
      "type": "object",
      "title": "Service Status Map",
      "description": "Maps service_key to status (active/inactive/error)",
      "additionalProperties": true
    },
    "revenue_mtd": {
      "type": "number",
      "title": "Revenue Month-to-Date",
      "default": 0
    },
    "metadata": {
      "type": "string",
      "title": "Additional Metadata"
    },
    "environment": {
      "type": "string",
      "title": "Environment",
      "enum": [
        "production",
        "qa",
        "smoke",
        "demo",
        "internal",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_excluded": {
      "type": "boolean",
      "title": "Excluded From Dashboard",
      "default": false
    },
    "dashboard_exclusion_reason": {
      "type": "string",
      "title": "Dashboard Exclusion Reason"
    },
    "dashboard_truth_status": {
      "type": "string",
      "title": "Dashboard Truth Status",
      "enum": [
        "trusted",
        "warning",
        "blocked",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_truth_notes": {
      "type": "string",
      "title": "Dashboard Truth Notes"
    }
  },
  "required": [
    "order_id",
    "business_name",
    "snapshot_date"
  ],
  "_metadata": {
    "status": "DERIVED",
    "reason": "Point-in-time metrics snapshot for dashboards only. Do NOT write directly. Derived from Leads + CommunicationEvent + Order. Use scheduled snapshot job only.",
    "read_only": true,
    "documentation": "ARCHITECTURE_CONSOLIDATION.md"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.order_id": {
            "$in": [
              "{{orders.id}}"
            ]
          }
        },
        {
          "data.client_project_id": "{{client_projects.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}