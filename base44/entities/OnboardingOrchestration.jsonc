{
  "name": "OnboardingOrchestration",
  "type": "object",
  "_metadata": {
    "status": "ONBOARDING_ORCHESTRATION",
    "reason": "Unified onboarding state orchestration \u2014 single source of truth for Order \u2192 ClientInstallationOS \u2192 OnboardingClient \u2192 AutomationChecklist synchronization.",
    "tenant_scoped": "client_id"
  },
  "properties": {
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "onboarding_client_id": {
      "type": "string",
      "title": "Linked OnboardingClient ID"
    },
    "installation_os_id": {
      "type": "string",
      "title": "Linked ClientInstallationOS ID"
    },
    "automation_checklist_id": {
      "type": "string",
      "title": "Linked AutomationChecklist ID"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "client_email": {
      "type": "string",
      "title": "Client Email"
    },
    "unified_stage": {
      "type": "string",
      "title": "Unified Onboarding Stage",
      "enum": [
        "intake_received",
        "setup_in_progress",
        "testing",
        "awaiting_client_approval",
        "live",
        "blocked"
      ],
      "default": "intake_received",
      "description": "Single source of truth for onboarding stage \u2014 synchronized across all onboarding entities"
    },
    "stage_progression": {
      "type": "array",
      "title": "Stage Progression Timeline",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "entered_at": {
            "type": "string",
            "format": "date-time"
          },
          "exited_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "order_status": {
      "type": "string",
      "title": "Order Status (Read from Order)",
      "enum": [
        "pending_payment",
        "paid_setup_in_progress",
        "partially_live",
        "fully_live"
      ]
    },
    "installation_status": {
      "type": "string",
      "title": "Installation Status (Read from ClientInstallationOS)",
      "enum": [
        "Paid",
        "Ready for Install",
        "Configuring",
        "Testing",
        "Live",
        "Error"
      ]
    },
    "checklist_status": {
      "type": "string",
      "title": "Automation Checklist Status (Read from AutomationChecklist)",
      "enum": [
        "not_started",
        "in_progress",
        "active",
        "failed",
        "paused"
      ]
    },
    "completion_metrics": {
      "type": "object",
      "title": "Onboarding Completion Metrics",
      "properties": {
        "total_checklist_steps": {
          "type": "integer",
          "default": 0
        },
        "completed_steps": {
          "type": "integer",
          "default": 0
        },
        "completion_percentage": {
          "type": "number",
          "default": 0
        },
        "last_updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "blockers": {
      "type": "array",
      "title": "Onboarding Blockers",
      "items": {
        "type": "object",
        "properties": {
          "blocker_id": {
            "type": "string"
          },
          "entity_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "identified_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "missing_setup_items": {
      "type": "array",
      "title": "Missing Setup Items",
      "items": {
        "type": "string"
      },
      "description": "List of items needed to progress (e.g., 'phone_number', 'booking_link', 'email_access')"
    },
    "ready_to_go_live": {
      "type": "boolean",
      "title": "Ready to Go Live",
      "default": false,
      "description": "All checklist items complete and no blockers"
    },
    "go_live_date": {
      "type": "string",
      "title": "Go-Live Date",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "title": "Last Orchestration Sync",
      "format": "date-time"
    },
    "sync_errors": {
      "type": "array",
      "title": "Recent Sync Errors",
      "items": {
        "type": "string"
      }
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Notes"
    }
  },
  "required": [
    "order_id",
    "client_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}