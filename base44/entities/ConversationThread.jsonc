{
  "name": "ConversationThread",
  "type": "object",
  "_metadata": {
    "status": "CORE_PRODUCTION",
    "reason": "Primary conversation grouping - groups messages and events into logical conversations. Write in thread management flows. Read by message viewers.",
    "tenant_scoped": "client_id",
    "documentation": "ARCHITECTURE_CONSOLIDATION.md"
  },
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "primary_channel": {
      "type": "string",
      "title": "Primary Channel",
      "enum": [
        "sms",
        "email",
        "webhook"
      ]
    },
    "last_message_at": {
      "type": "string",
      "title": "Last Message At"
    },
    "thread_status": {
      "type": "string",
      "title": "Thread Status",
      "enum": [
        "open",
        "active",
        "closed"
      ],
      "default": "open"
    },
    "message_count": {
      "type": "integer",
      "title": "Message Count",
      "default": 0
    }
  },
  "required": [
    "lead_id",
    "primary_channel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    }
  }
}