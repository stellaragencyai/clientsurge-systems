{
  "name": "ConversionOptimizationSignal",
  "type": "object",
  "_metadata": {
    "status": "CONVERSION_OPTIMIZATION",
    "reason": "Derived insights layer: optimization signals, recommendations, and improvement opportunities. Auto-generated by computeConversionOptimization function.",
    "read_only": true,
    "async_only": true,
    "tenant_scoped": "client_id + client_project_id",
    "documentation": "CONVERSION_OPTIMIZATION.md"
  },
  "properties": {
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "signal_type": {
      "type": "string",
      "title": "Signal Type",
      "enum": [
        "funnel_drop_off",
        "underperforming_message",
        "underperforming_source",
        "high_intent_missed",
        "revenue_leakage",
        "conversion_bottleneck",
        "success_pattern_detected"
      ]
    },
    "severity": {
      "type": "string",
      "title": "Severity",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "title": {
      "type": "string",
      "title": "Signal Title",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "title": "Signal Description",
      "maxLength": 1000
    },
    "metric_affected": {
      "type": "string",
      "title": "Primary Metric Affected",
      "enum": [
        "conversion_rate",
        "revenue_per_lead",
        "response_rate",
        "booking_rate",
        "churn_rate",
        "time_to_conversion"
      ]
    },
    "current_value": {
      "type": "number",
      "title": "Current Metric Value"
    },
    "benchmark_value": {
      "type": "number",
      "title": "Benchmark/Expected Value"
    },
    "variance_percent": {
      "type": "number",
      "title": "Variance from Benchmark %"
    },
    "financial_impact": {
      "type": "object",
      "title": "Financial Impact",
      "properties": {
        "estimated_revenue_loss_monthly": {
          "type": "number"
        },
        "estimated_opportunity_monthly": {
          "type": "number"
        },
        "confidence_level_percent": {
          "type": "number"
        }
      }
    },
    "affected_entity_type": {
      "type": "string",
      "title": "Affected Entity Type",
      "enum": [
        "message_template",
        "email_sequence",
        "funnel_stage",
        "lead_source",
        "utm_campaign",
        "automation_rule",
        "landing_page"
      ]
    },
    "affected_entity_id": {
      "type": "string",
      "title": "Affected Entity ID"
    },
    "affected_entity_name": {
      "type": "string",
      "title": "Affected Entity Name"
    },
    "recommended_actions": {
      "type": "array",
      "title": "Recommended Actions",
      "items": {
        "type": "object",
        "properties": {
          "action_number": {
            "type": "integer"
          },
          "action": {
            "type": "string"
          },
          "expected_impact": {
            "type": "string"
          },
          "effort_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "related_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Related Signal IDs"
    },
    "period_analyzed": {
      "type": "string",
      "title": "Analysis Period",
      "enum": [
        "24h",
        "7d",
        "30d"
      ]
    },
    "first_detected_at": {
      "type": "string",
      "title": "First Detected At",
      "format": "date-time"
    },
    "last_detected_at": {
      "type": "string",
      "title": "Last Detected At",
      "format": "date-time"
    },
    "is_acknowledged": {
      "type": "boolean",
      "title": "Is Acknowledged",
      "default": false
    },
    "acknowledged_by": {
      "type": "string",
      "title": "Acknowledged By (User Email)"
    },
    "acknowledged_at": {
      "type": "string",
      "title": "Acknowledged At",
      "format": "date-time"
    },
    "action_taken": {
      "type": "string",
      "title": "Action Taken"
    },
    "status": {
      "type": "string",
      "title": "Signal Status",
      "enum": [
        "active",
        "resolved",
        "investigating",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "client_project_id",
    "signal_type",
    "title"
  ]
}
