{
  "name": "GA4Configuration",
  "type": "object",
  "properties": {
    "measurement_id": {
      "type": "string",
      "title": "GA4 Measurement ID",
      "description": "Public Google Analytics 4 web-stream measurement ID (G-XXXXXXXXXX)"
    },
    "enabled": {
      "type": "boolean",
      "title": "Enabled",
      "default": false,
      "description": "Whether GA4 tracking is active"
    },
    "tracked_events": {
      "type": "array",
      "title": "Tracked Events",
      "description": "Canonical event names the ClientSurge application can emit",
      "items": {
        "type": "string",
        "enum": [
          "page_view",
          "scroll",
          "scroll_depth",
          "cta_click",
          "pricing_view",
          "link_click",
          "form_submit_attempt",
          "form_submit",
          "generate_lead",
          "contact_form_submit",
          "audit_request_started",
          "audit_request_submitted",
          "begin_checkout",
          "purchase",
          "purchase_client_confirmation",
          "demo_booked",
          "onboarding_complete"
        ]
      },
      "default": [
        "page_view",
        "scroll",
        "cta_click",
        "pricing_view",
        "form_submit_attempt",
        "form_submit",
        "generate_lead",
        "contact_form_submit",
        "audit_request_started",
        "audit_request_submitted",
        "begin_checkout",
        "purchase",
        "purchase_client_confirmation",
        "demo_booked"
      ]
    },
    "setup_status": {
      "type": "string",
      "title": "Setup Status",
      "enum": [
        "not_configured",
        "configured",
        "active",
        "error"
      ],
      "default": "not_configured",
      "description": "Current configuration state"
    },
    "setup_guide": {
      "type": "string",
      "title": "Setup Guide",
      "description": "Step-by-step GA4 integration instructions"
    },
    "enhanced_measurement_enabled": {
      "type": "boolean",
      "title": "Enhanced Measurement Enabled",
      "default": false
    },
    "conversion_events": {
      "type": "array",
      "title": "GA4 Key Events",
      "items": {
        "type": "string",
        "enum": [
          "generate_lead",
          "begin_checkout",
          "purchase",
          "demo_booked"
        ]
      },
      "default": [
        "generate_lead",
        "begin_checkout",
        "purchase",
        "demo_booked"
      ],
      "description": "Intended GA4 key events. This documents the desired GA4 Admin configuration; it does not call the Google Analytics Admin API."
    },
    "server_side_tracking_enabled": {
      "type": "boolean",
      "title": "Server-Side Tracking Enabled",
      "default": false,
      "description": "True only after backend Measurement Protocol delivery has been verified. GA4_API_SECRET must live in Base44 Secrets, never in this entity."
    },
    "last_verified_at": {
      "type": "string",
      "title": "Last Verified At",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "title": "Admin Notes"
    }
  },
  "required": [
    "measurement_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}
