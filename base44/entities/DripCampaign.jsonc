{
  "name": "DripCampaign",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "tenant_scope_error": {
      "type": "string",
      "title": "Tenant Scope Error"
    },
    "lead_name": {
      "type": "string",
      "title": "Lead Name"
    },
    "lead_email": {
      "type": "string",
      "title": "Lead Email"
    },
    "lead_phone": {
      "type": "string",
      "title": "Lead Phone"
    },
    "status": {
      "type": "string",
      "title": "Campaign Status",
      "enum": [
        "active",
        "paused",
        "completed",
        "stopped"
      ],
      "default": "active"
    },
    "stop_reason": {
      "type": "string",
      "title": "Stop Reason",
      "enum": [
        "qualified",
        "booked",
        "closed",
        "manual_pause",
        "opted_out",
        "completed_all_steps"
      ]
    },
    "enrolled_at": {
      "type": "string",
      "title": "Enrolled At"
    },
    "day1_sent_at": {
      "type": "string",
      "title": "Day 1 Sent At"
    },
    "day3_sent_at": {
      "type": "string",
      "title": "Day 3 Sent At"
    },
    "day7_sent_at": {
      "type": "string",
      "title": "Day 7 Sent At"
    },
    "day1_status": {
      "type": "string",
      "title": "Day 1 Status",
      "enum": [
        "pending",
        "sent",
        "skipped",
        "failed"
      ],
      "default": "pending"
    },
    "day3_status": {
      "type": "string",
      "title": "Day 3 Status",
      "enum": [
        "pending",
        "sent",
        "skipped",
        "failed"
      ],
      "default": "pending"
    },
    "day7_status": {
      "type": "string",
      "title": "Day 7 Status",
      "enum": [
        "pending",
        "sent",
        "skipped",
        "failed"
      ],
      "default": "pending"
    },
    "last_step_run_at": {
      "type": "string",
      "title": "Last Step Run At"
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "lead_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}