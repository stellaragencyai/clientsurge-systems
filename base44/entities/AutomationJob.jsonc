{
  "name": "AutomationJob",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "job_type": {
      "type": "string",
      "title": "Job Type",
      "enum": [
        "instant_sms",
        "confirmation_email",
        "admin_notification",
        "nurture_sequence",
        "webhook_dispatch",
        "reactivation_sms",
        "reactivation_email"
      ]
    },
    "trigger_event": {
      "type": "string",
      "title": "Trigger Event"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "queued",
        "processing",
        "completed",
        "failed"
      ]
    },
    "attempts": {
      "type": "integer",
      "title": "Attempts",
      "default": 0
    },
    "last_error": {
      "type": "string",
      "title": "Last Error"
    },
    "scheduled_for": {
      "type": "string",
      "title": "Scheduled For"
    },
    "processed_at": {
      "type": "string",
      "title": "Processed At"
    },
    "result_metadata": {
      "type": "string",
      "title": "Result Metadata"
    }
  },
  "required": [
    "lead_id",
    "job_type",
    "status"
  ]
}
