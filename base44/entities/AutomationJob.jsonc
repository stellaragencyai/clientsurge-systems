{
  "name": "AutomationJob",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "tenant_scope_error": {
      "type": "string",
      "title": "Tenant Scope Error"
    },
    "job_type": {
      "type": "string",
      "title": "Job Type",
      "enum": [
        "instant_sms",
        "confirmation_email",
        "admin_notification",
        "nurture_sequence",
        "webhook_dispatch"
      ]
    },
    "trigger_event": {
      "type": "string",
      "title": "Trigger Event"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "queued",
        "retryable",
        "processing",
        "completed",
        "failed",
        "terminal",
        "dead_letter",
        "manual_review"
      ]
    },
    "attempts": {
      "type": "integer",
      "title": "Attempts",
      "default": 0
    },
    "last_error": {
      "type": "string",
      "title": "Last Error"
    },
    "terminal_reason": {
      "type": "string",
      "title": "Terminal Reason"
    },
    "retry_after": {
      "type": "string",
      "title": "Retry After",
      "format": "date-time"
    },
    "scheduled_for": {
      "type": "string",
      "title": "Scheduled For"
    },
    "processed_at": {
      "type": "string",
      "title": "Processed At"
    },
    "provider_from_number": {
      "type": "string",
      "title": "Provider From Number (SMS)"
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email"
    },
    "result_metadata": {
      "type": "string",
      "title": "Result Metadata"
    }
  },
  "required": [
    "lead_id",
    "job_type",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
