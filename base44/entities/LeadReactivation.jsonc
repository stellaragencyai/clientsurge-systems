{
  "name": "LeadReactivation",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "last_contact_date": {
      "type": "string",
      "title": "Last Contact Date"
    },
    "days_dormant": {
      "type": "number",
      "title": "Days Dormant"
    },
    "reactivation_stage": {
      "type": "string",
      "title": "Reactivation Stage",
      "enum": [
        "identified",
        "first_touch",
        "second_touch",
        "final_offer",
        "archived"
      ],
      "default": "identified"
    },
    "trigger_reason": {
      "type": "string",
      "title": "Why Dormant",
      "enum": [
        "no_response",
        "objection_timing",
        "no_booking",
        "manual_pause"
      ]
    },
    "reactivation_offer": {
      "type": "string",
      "title": "Reactivation Offer"
    },
    "attempts": {
      "type": "number",
      "title": "Reactivation Attempts",
      "default": 0
    },
    "reopened_at": {
      "type": "string",
      "title": "Reopened At"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "dormant",
        "reactivating",
        "reactivated",
        "unrecoverable"
      ],
      "default": "dormant"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "lead_id",
    "last_contact_date",
    "days_dormant"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}