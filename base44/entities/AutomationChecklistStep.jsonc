{
  "name": "AutomationChecklistStep",
  "type": "object",
  "properties": {
    "automation_checklist_id": {
      "type": "string",
      "title": "Parent Checklist ID"
    },
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "service_key": {
      "type": "string",
      "title": "Service Key",
      "enum": [
        "instant_lead_response",
        "missed_call_text_back",
        "nurture_sequence_14d",
        "ai_booking_agent",
        "daily_lead_digest",
        "inbound_sms_assistant",
        "ai_voice_receptionist",
        "lead_reactivation",
        "review_request"
      ]
    },
    "step_id": {
      "type": "string",
      "title": "Step Identifier"
    },
    "step_label": {
      "type": "string",
      "title": "Display Label"
    },
    "step_order": {
      "type": "integer",
      "title": "Display Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Checkbox Status",
      "enum": [
        "pending",
        "in_progress",
        "complete",
        "failed"
      ],
      "default": "pending"
    },
    "completed_at": {
      "type": "string",
      "title": "Completed At",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string",
      "title": "Completed By (Admin Email)"
    },
    "notes": {
      "type": "string",
      "title": "Step Notes"
    },
    "error_message": {
      "type": "string",
      "title": "Error Message (if failed)"
    }
  },
  "required": [
    "automation_checklist_id",
    "service_key",
    "step_id",
    "step_label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.order_id": {
            "$in": [
              "{{client_projects.order_id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.order_id": {
            "$in": [
              "{{client_projects.order_id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}