{
  "name": "MessageTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Template Name",
      "description": "e.g. instant_response, nurture_welcome, booking_confirmation"
    },
    "type": {
      "type": "string",
      "title": "Message Type",
      "enum": [
        "sms",
        "email"
      ],
      "description": "SMS or Email template"
    },
    "body": {
      "type": "string",
      "title": "Template Body",
      "description": "Message template with {{variables}} for personalization"
    },
    "service_key": {
      "type": "string",
      "title": "Associated Service",
      "description": "Which service this template belongs to"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "active"
    },
    "ab_test_variant": {
      "type": "string",
      "title": "A/B Test Variant",
      "enum": [
        "A",
        "B",
        "control",
        "winner"
      ]
    },
    "variant_sends": {
      "type": "integer",
      "title": "Variant Sends",
      "default": 0
    },
    "variant_replies": {
      "type": "integer",
      "title": "Variant Replies",
      "default": 0
    },
    "reply_rate": {
      "type": "number",
      "title": "Reply Rate",
      "default": 0
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Template Variables",
      "description": "Auto-extracted variables like name, business, date, etc."
    },
    "created_at": {
      "type": "string",
      "title": "Created At"
    },
    "updated_at": {
      "type": "string",
      "title": "Updated At"
    }
  },
  "required": [
    "name",
    "type",
    "body",
    "service_key"
  ]
}
