{
  "name": "MessageTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Template Name"
    },
    "type": {
      "type": "string",
      "title": "Message Type",
      "enum": [
        "sms",
        "email"
      ]
    },
    "body": {
      "type": "string",
      "title": "Template Body"
    },
    "service_key": {
      "type": "string",
      "title": "Associated Service"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID",
      "description": "Blank/null for global admin templates."
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "system_internal",
      "description": "system_internal for global templates."
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "active"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Template Variables"
    },
    "created_at": {
      "type": "string",
      "title": "Created At"
    },
    "updated_at": {
      "type": "string",
      "title": "Updated At"
    }
  },
  "required": [
    "name",
    "type",
    "body",
    "service_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        },
        {
          "data.tenant_scope_status": "system_internal"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}