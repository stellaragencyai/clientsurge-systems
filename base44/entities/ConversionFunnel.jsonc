{
  "name": "ConversionFunnel",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "funnel_name": {
      "type": "string",
      "title": "Funnel Name"
    },
    "metric_period": {
      "type": "string",
      "title": "Metric Period",
      "enum": [
        "1d",
        "7d",
        "30d",
        "90d"
      ]
    },
    "period_start": {
      "type": "string",
      "title": "Period Start",
      "format": "date-time"
    },
    "period_end": {
      "type": "string",
      "title": "Period End",
      "format": "date-time"
    },
    "funnel_stages": {
      "type": "array",
      "title": "Funnel Stages with Metrics",
      "items": {
        "type": "object",
        "properties": {
          "stage_name": {
            "type": "string",
            "enum": [
              "visit",
              "lead_created",
              "contacted",
              "replied",
              "booked",
              "payment_initiated",
              "paid",
              "activated"
            ]
          },
          "stage_number": {
            "type": "integer"
          },
          "total_count": {
            "type": "integer"
          },
          "conversion_from_previous_percent": {
            "type": "number"
          },
          "conversion_from_top_percent": {
            "type": "number"
          },
          "average_time_to_stage_hours": {
            "type": "number"
          },
          "median_time_to_stage_hours": {
            "type": "number"
          }
        }
      }
    },
    "top_to_bottom_conversion_percent": {
      "type": "number",
      "title": "Overall Funnel Conversion %"
    },
    "biggest_drop_off_stage": {
      "type": "string",
      "title": "Stage with Biggest Drop-Off"
    },
    "biggest_drop_off_percent": {
      "type": "number",
      "title": "Biggest Drop-Off %"
    },
    "revenue_per_funnel_entrant": {
      "type": "number",
      "title": "Average Revenue Per Initial Lead ($)"
    },
    "total_revenue_attributed": {
      "type": "number",
      "title": "Total Revenue in Period ($)"
    },
    "by_source": {
      "type": "object",
      "title": "Conversion Metrics by Lead Source",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "leads_count": {
            "type": "integer"
          },
          "conversion_rate_percent": {
            "type": "number"
          },
          "revenue_attributed": {
            "type": "number"
          },
          "revenue_per_lead": {
            "type": "number"
          }
        }
      }
    },
    "by_utm_source": {
      "type": "object",
      "title": "Conversion Metrics by UTM Source",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "leads_count": {
            "type": "integer"
          },
          "conversion_rate_percent": {
            "type": "number"
          },
          "revenue_attributed": {
            "type": "number"
          }
        }
      }
    },
    "computed_at": {
      "type": "string",
      "title": "Computed At",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "title": "Environment",
      "enum": [
        "production",
        "qa",
        "smoke",
        "demo",
        "internal",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_excluded": {
      "type": "boolean",
      "title": "Excluded From Dashboard",
      "default": false
    },
    "dashboard_exclusion_reason": {
      "type": "string",
      "title": "Dashboard Exclusion Reason"
    },
    "dashboard_truth_status": {
      "type": "string",
      "title": "Dashboard Truth Status",
      "enum": [
        "trusted",
        "warning",
        "blocked",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_truth_notes": {
      "type": "string",
      "title": "Dashboard Truth Notes"
    }
  },
  "required": [
    "client_project_id",
    "funnel_stages",
    "metric_period"
  ],
  "_metadata": {
    "status": "CONVERSION_OPTIMIZATION",
    "reason": "Tracks conversion funnel metrics per ClientProject. Derived from Leads -> Orders -> Subscriptions. No-write, metrics-only entity.",
    "read_only": true,
    "async_only": true,
    "tenant_scoped": "client_id + client_project_id",
    "documentation": "CONVERSION_OPTIMIZATION.md",
    "product_layer": "intelligence",
    "metric_role": "primary_kpi_source_of_truth",
    "visibility": "dashboard_primary",
    "architecture_level": "analytics"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}