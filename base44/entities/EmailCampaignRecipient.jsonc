{
  "name": "EmailCampaignRecipient",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "campaign_id": {
      "type": "string",
      "title": "Campaign ID"
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "tenant_scope_error": {
      "type": "string",
      "title": "Tenant Scope Error"
    },
    "email": {
      "type": "string",
      "title": "Email Address"
    },
    "lead_name": {
      "type": "string",
      "title": "Lead Name"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "opened",
        "clicked",
        "bounced",
        "unsubscribed",
        "failed"
      ],
      "default": "pending"
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email"
    },
    "sent_at": {
      "type": "string",
      "title": "Sent At"
    },
    "delivered_at": {
      "type": "string",
      "title": "Delivered At"
    },
    "opened_at": {
      "type": "string",
      "title": "Opened At"
    },
    "clicked_at": {
      "type": "string",
      "title": "Clicked At"
    },
    "unsubscribed_at": {
      "type": "string",
      "title": "Unsubscribed At"
    },
    "bounced_at": {
      "type": "string",
      "title": "Bounced At"
    },
    "resend_message_id": {
      "type": "string",
      "title": "Resend Message ID"
    },
    "error_message": {
      "type": "string",
      "title": "Error Message"
    },
    "suppression_reason": {
      "type": "string",
      "title": "Suppression Reason"
    },
    "open_count": {
      "type": "number",
      "title": "Open Count",
      "default": 0
    },
    "click_count": {
      "type": "number",
      "title": "Click Count",
      "default": 0
    }
  },
  "required": [
    "campaign_id",
    "lead_id",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}