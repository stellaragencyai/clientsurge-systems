{
  "name": "ClientDeployment",
  "type": "object",
  "title": "Client Deployment",
  "description": "Source of truth for an active customer system \u2014 links a client to their IndustryConfig, PackageTier, and activated automation modules.",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "client_id": {
      "type": "string",
      "title": "Client ID",
      "description": "Tenant isolation key \u2014 links to Client/ClientProject"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID",
      "description": "Links to ClientProject entity for legacy compatibility"
    },
    "order_id": {
      "type": "string",
      "title": "Order ID",
      "description": "Stripe order that triggered this deployment"
    },
    "industry_config_id": {
      "type": "string",
      "title": "Industry Config ID",
      "description": "FK to IndustryConfig record"
    },
    "industry_slug": {
      "type": "string",
      "title": "Industry Slug",
      "description": "Denormalized slug for quick lookups (e.g., 'hvac-ai-growth-system')"
    },
    "package_tier_id": {
      "type": "string",
      "title": "Package Tier ID",
      "description": "FK to PackageTier record"
    },
    "package_tier_key": {
      "type": "string",
      "title": "Package Tier Key",
      "description": "Denormalized tier key (e.g., 'starter', 'growth', 'pro')"
    },
    "deployment_status": {
      "type": "string",
      "title": "Deployment Status",
      "enum": [
        "pending",
        "onboarding",
        "configuring",
        "ready",
        "live",
        "error",
        "paused",
        "cancelled"
      ],
      "default": "pending"
    },
    "activated_modules": {
      "type": "array",
      "title": "Activated Modules",
      "items": {
        "type": "string"
      },
      "description": "List of AutomationModule keys currently activated for this deployment"
    },
    "module_installation_status": {
      "type": "object",
      "title": "Module Installation Status",
      "description": "Per-module verification status \u2014 tracks whether each module is truly installed and verified, not just listed as active",
      "properties": {
        "instant_lead_response": {
          "type": "string",
          "enum": [
            "not_started",
            "installing",
            "installed",
            "verified",
            "failed"
          ],
          "default": "not_started"
        },
        "missed_call_text_back": {
          "type": "string",
          "enum": [
            "not_started",
            "installing",
            "installed",
            "verified",
            "failed"
          ],
          "default": "not_started"
        },
        "lead_nurture": {
          "type": "string",
          "enum": [
            "not_started",
            "installing",
            "installed",
            "verified",
            "failed"
          ],
          "default": "not_started"
        },
        "ai_booking_agent": {
          "type": "string",
          "enum": [
            "not_started",
            "installing",
            "installed",
            "verified",
            "failed"
          ],
          "default": "not_started"
        },
        "daily_digest": {
          "type": "string",
          "enum": [
            "not_started",
            "installing",
            "installed",
            "verified",
            "failed"
          ],
          "default": "not_started"
        },
        "review_reactivation": {
          "type": "string",
          "enum": [
            "not_started",
            "installing",
            "installed",
            "verified",
            "failed"
          ],
          "default": "not_started"
        }
      }
    },
    "installation_progress": {
      "type": "object",
      "title": "Installation Progress",
      "properties": {
        "completion_percentage": {
          "type": "number",
          "default": 0
        },
        "completed_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_step": {
          "type": "string"
        }
      }
    },
    "config_snapshot": {
      "type": "object",
      "title": "Config Snapshot",
      "description": "Frozen copy of IndustryConfig + PackageTier at deployment time \u2014 ensures consistent rendering even if source config changes"
    },
    "errors": {
      "type": "array",
      "title": "Deployment Errors",
      "items": {
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "module_key": {
            "type": "string",
            "description": "Which module this error relates to"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "critical",
              "advisory"
            ],
            "default": "warning"
          },
          "suggested_action": {
            "type": "string",
            "description": "Recommended fix action for admin"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "health_status": {
      "type": "string",
      "title": "Health Status",
      "enum": [
        "healthy",
        "warning",
        "critical",
        "unknown"
      ],
      "default": "unknown",
      "description": "Computed by calculateDeploymentHealth \u2014 cached for quick admin lookup"
    },
    "health_summary": {
      "type": "string",
      "title": "Health Summary",
      "description": "Human-readable health summary (e.g., 'All required modules installed and verified')"
    },
    "health_checked_at": {
      "type": "string",
      "title": "Last Health Check At",
      "format": "date-time"
    },
    "analytics": {
      "type": "object",
      "title": "Deployment Analytics",
      "description": "Tracking infrastructure for future metrics \u2014 values populated by automation execution pipeline",
      "properties": {
        "leads_generated": {
          "type": "number",
          "default": 0
        },
        "conversations_started": {
          "type": "number",
          "default": 0
        },
        "appointments_booked": {
          "type": "number",
          "default": 0
        },
        "automation_executions": {
          "type": "number",
          "default": 0
        },
        "recovered_opportunities": {
          "type": "number",
          "default": 0
        },
        "last_activity_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "went_live_at": {
      "type": "string",
      "title": "Went Live At",
      "format": "date-time"
    },
    "last_status_check_at": {
      "type": "string",
      "title": "Last Status Check At",
      "format": "date-time"
    }
  },
  "required": [
    "client_id",
    "industry_config_id",
    "package_tier_id",
    "deployment_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}