{
  "name": "ClientDeployment",
  "type": "object",
  "title": "Client Deployment",
  "description": "Source of truth for an active customer system \u2014 links a client to their IndustryConfig, PackageTier, and activated automation modules.",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "client_id": {
      "type": "string",
      "title": "Client ID",
      "description": "Tenant isolation key \u2014 links to Client/ClientProject"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID",
      "description": "Links to ClientProject entity for legacy compatibility"
    },
    "order_id": {
      "type": "string",
      "title": "Order ID",
      "description": "Stripe order that triggered this deployment"
    },
    "industry_config_id": {
      "type": "string",
      "title": "Industry Config ID",
      "description": "FK to IndustryConfig record"
    },
    "industry_slug": {
      "type": "string",
      "title": "Industry Slug",
      "description": "Denormalized slug for quick lookups (e.g., 'hvac-ai-growth-system')"
    },
    "package_tier_id": {
      "type": "string",
      "title": "Package Tier ID",
      "description": "FK to PackageTier record"
    },
    "package_tier_key": {
      "type": "string",
      "title": "Package Tier Key",
      "description": "Denormalized tier key (e.g., 'starter', 'growth', 'pro')"
    },
    "deployment_status": {
      "type": "string",
      "title": "Deployment Status",
      "enum": [
        "onboarding",
        "configuring",
        "ready",
        "live",
        "error",
        "paused"
      ],
      "default": "onboarding"
    },
    "activated_modules": {
      "type": "array",
      "title": "Activated Modules",
      "items": {
        "type": "string"
      },
      "description": "List of AutomationModule keys currently activated for this deployment"
    },
    "installation_progress": {
      "type": "object",
      "title": "Installation Progress",
      "properties": {
        "completion_percentage": {
          "type": "number",
          "default": 0
        },
        "completed_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_step": {
          "type": "string"
        }
      }
    },
    "config_snapshot": {
      "type": "object",
      "title": "Config Snapshot",
      "description": "Frozen copy of IndustryConfig + PackageTier at deployment time \u2014 ensures consistent rendering even if source config changes"
    },
    "errors": {
      "type": "array",
      "title": "Errors",
      "items": {
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "went_live_at": {
      "type": "string",
      "title": "Went Live At",
      "format": "date-time"
    },
    "last_status_check_at": {
      "type": "string",
      "title": "Last Status Check At",
      "format": "date-time"
    }
  },
  "required": [
    "client_id",
    "industry_config_id",
    "package_tier_id",
    "deployment_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}