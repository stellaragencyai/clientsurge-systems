{
  "name": "ClientProject",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (links to Client entity)"
    },
    "client_email": {
      "type": "string",
      "title": "Client Email"
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email"
    },
    "client_name": {
      "type": "string",
      "title": "Client Name"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "plan": {
      "type": "string",
      "title": "Current Plan",
      "enum": [
        "Starter System",
        "Growth System",
        "Pro System"
      ],
      "default": "Starter System"
    },
    "plan_change_request": {
      "type": "string",
      "title": "Plan Change Request",
      "enum": [
        "None",
        "Starter System",
        "Growth System",
        "Pro System"
      ],
      "default": "None"
    },
    "client_project_status": {
      "type": "string",
      "title": "Fulfillment Project Status",
      "enum": [
        "Payment Received",
        "Onboarding Pending",
        "Access Requested",
        "Access Verified",
        "Setup In Progress",
        "QA In Progress",
        "Awaiting Client Approval",
        "Go-Live Scheduled",
        "Live",
        "Monitoring",
        "Monthly Support",
        "Blocked",
        "Paused",
        "Canceled"
      ],
      "default": "Payment Received"
    },
    "support_priority": {
      "type": "string",
      "title": "Support Priority",
      "enum": [
        "Urgent",
        "High",
        "Normal",
        "Low"
      ],
      "default": "Normal"
    },
    "support_status": {
      "type": "string",
      "title": "Support Status",
      "enum": [
        "No Open Issues",
        "Open",
        "Waiting On Client",
        "Waiting On Provider",
        "Monitoring",
        "Resolved"
      ],
      "default": "No Open Issues"
    },
    "qa_status": {
      "type": "string",
      "title": "QA Status",
      "enum": [
        "Not Started",
        "In Progress",
        "Passed",
        "Failed",
        "Blocked"
      ],
      "default": "Not Started"
    },
    "client_approval_status": {
      "type": "string",
      "title": "Client Approval Status",
      "enum": [
        "Not Requested",
        "Requested",
        "Approved",
        "Changes Requested",
        "Blocked"
      ],
      "default": "Not Requested"
    },
    "monitoring_status": {
      "type": "string",
      "title": "Post-Launch Monitoring Status",
      "enum": [
        "Not Started",
        "Day 1",
        "Day 2",
        "Day 3",
        "Day 7",
        "Monthly Support",
        "Blocked",
        "Complete"
      ],
      "default": "Not Started"
    },
    "step_onboarding": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending",
      "title": "Step 1: Onboarding Form"
    },
    "step_payment": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending",
      "title": "Step 2: Payment Confirmed"
    },
    "step_system_setup": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending",
      "title": "Step 3: System Setup"
    },
    "step_sms": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending",
      "title": "Step 4: SMS Connected"
    },
    "step_email": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending",
      "title": "Step 5: Email Connected"
    },
    "step_booking": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending",
      "title": "Step 6: Booking Flow Live"
    },
    "step_followup": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending",
      "title": "Step 7: Follow-Up Active"
    },
    "step_live": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending",
      "title": "Step 8: Full System Running"
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Notes (internal)"
    },
    "timeline_person_name": {
      "type": "string",
      "title": "Timeline Person Name"
    },
    "timeline_birth_date": {
      "type": "string",
      "title": "Timeline Birth Date"
    },
    "timeline_death_date": {
      "type": "string",
      "title": "Timeline Death Date"
    },
    "go_live_date": {
      "type": "string",
      "title": "Go-Live Date"
    },
    "deadlines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "overdue"
            ],
            "default": "pending"
          },
          "category": {
            "type": "string",
            "enum": [
              "setup",
              "payment",
              "testing",
              "launch"
            ],
            "default": "setup"
          }
        }
      },
      "title": "Project Deadlines"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "documentation",
              "setup-guide",
              "credentials",
              "report"
            ],
            "default": "documentation"
          }
        }
      },
      "title": "Project Files"
    },
    "onboarding_wizard_completed": {
      "type": "boolean",
      "title": "Onboarding Wizard Completed",
      "default": false
    },
    "environment": {
      "type": "string",
      "title": "Environment",
      "enum": [
        "production",
        "qa",
        "smoke",
        "demo",
        "internal",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_excluded": {
      "type": "boolean",
      "title": "Excluded From Dashboard",
      "default": false
    },
    "dashboard_exclusion_reason": {
      "type": "string",
      "title": "Dashboard Exclusion Reason"
    },
    "dashboard_truth_status": {
      "type": "string",
      "title": "Dashboard Truth Status",
      "enum": [
        "trusted",
        "warning",
        "blocked",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_truth_notes": {
      "type": "string",
      "title": "Dashboard Truth Notes"
    }
  },
  "required": [
    "client_email",
    "client_name",
    "business_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.contact_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}