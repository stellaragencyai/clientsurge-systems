{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "sender_email": {
      "type": "string",
      "title": "Sender Email"
    },
    "sender_name": {
      "type": "string",
      "title": "Sender Name"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "enum": [
        "client",
        "admin"
      ],
      "default": "client"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "read": {
      "type": "boolean",
      "title": "Read",
      "default": false
    }
  },
  "required": [
    "project_id",
    "sender_email",
    "message",
    "role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.project_id": "{{client_projects.id}}"
        },
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.project_id": "{{client_projects.id}}"
        },
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.project_id": "{{client_projects.id}}"
        },
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}