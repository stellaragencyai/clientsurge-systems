{
  "name": "ClientChangeRequest",
  "type": "object",
  "description": "Client-submitted request to change project, checklist, or checklist-step details. This preserves client input without letting customers mutate authoritative install truth directly.",
  "properties": {
    "target_entity": {
      "type": "string",
      "title": "Target Entity",
      "enum": [
        "ClientProject",
        "AutomationChecklist",
        "AutomationChecklistStep"
      ]
    },
    "target_id": {
      "type": "string",
      "title": "Target Record ID"
    },
    "requested_changes": {
      "type": "object",
      "title": "Requested Changes"
    },
    "request_reason": {
      "type": "string",
      "title": "Request Reason",
      "maxLength": 2000
    },
    "requested_by_user_id": {
      "type": "string",
      "title": "Requested By User ID"
    },
    "requested_by_email": {
      "type": "string",
      "title": "Requested By Email"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "status": {
      "type": "string",
      "title": "Review Status",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "applied",
        "cancelled"
      ],
      "default": "pending"
    },
    "target_snapshot": {
      "type": "object",
      "title": "Target Snapshot"
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Notes"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed By"
    },
    "reviewed_at": {
      "type": "string",
      "title": "Reviewed At",
      "format": "date-time"
    },
    "applied_at": {
      "type": "string",
      "title": "Applied At",
      "format": "date-time"
    },
    "source_route": {
      "type": "string",
      "title": "Source Route"
    }
  },
  "required": [
    "target_entity",
    "target_id",
    "requested_by_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.requested_by_email": "{{user.email}}"
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
