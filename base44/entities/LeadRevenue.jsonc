{
  "name": "LeadRevenue",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "source": {
      "type": "string",
      "title": "Lead Source",
      "enum": [
        "phone",
        "form",
        "referral",
        "ad",
        "sms",
        "email",
        "social",
        "other"
      ]
    },
    "booking_id": {
      "type": "string",
      "title": "Booking ID"
    },
    "revenue_amount": {
      "type": "number",
      "title": "Revenue (USD)"
    },
    "service_type": {
      "type": "string",
      "title": "Service Type"
    },
    "repeat_customer": {
      "type": "boolean",
      "title": "Repeat Customer",
      "default": false
    },
    "booking_date": {
      "type": "string",
      "title": "Booking Date"
    },
    "revenue_date": {
      "type": "string",
      "title": "Revenue Date"
    },
    "lifetime_value": {
      "type": "number",
      "title": "Lifetime Value (USD)"
    },
    "total_bookings": {
      "type": "number",
      "title": "Total Bookings"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "lead_id",
    "source",
    "booking_id",
    "revenue_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}