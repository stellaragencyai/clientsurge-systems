{
  "name": "SocialContentLog",
  "type": "object",
  "properties": {
    "industry": {
      "type": "string",
      "title": "Industry",
      "enum": [
        "general",
        "med_spa",
        "dental",
        "chiropractic",
        "hvac",
        "roofing",
        "contractors"
      ]
    },
    "content_type": {
      "type": "string",
      "title": "Content Type",
      "enum": [
        "blog_post",
        "linkedin",
        "instagram",
        "facebook",
        "twitter",
        "tiktok_script",
        "social_starter_pack"
      ]
    },
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "client_email": {
      "type": "string",
      "title": "Client Email"
    },
    "caption_category": {
      "type": "string",
      "title": "Caption Category",
      "enum": [
        "lead_gen",
        "social_proof"
      ]
    },
    "platform": {
      "type": "string",
      "title": "Target Platform"
    },
    "title": {
      "type": "string",
      "title": "Title / Headline"
    },
    "body": {
      "type": "string",
      "title": "Content Body"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Hashtags"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "approved",
        "scheduled",
        "posted",
        "archived"
      ],
      "default": "draft"
    },
    "scheduled_for": {
      "type": "string",
      "title": "Scheduled For",
      "format": "date-time"
    },
    "posted_at": {
      "type": "string",
      "title": "Posted At",
      "format": "date-time"
    },
    "topic": {
      "type": "string",
      "title": "Topic / Theme"
    },
    "word_count": {
      "type": "integer",
      "title": "Word Count"
    },
    "seo_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "SEO Keywords"
    },
    "generated_by": {
      "type": "string",
      "title": "Generated By (automation / admin email)"
    },
    "notes": {
      "type": "string",
      "title": "Editor Notes"
    },
    "file_base64": {
      "type": "string",
      "title": "Generated File Base64"
    },
    "file_mime_type": {
      "type": "string",
      "title": "Generated File MIME Type"
    }
  },
  "required": [
    "industry",
    "content_type",
    "title",
    "body"
  ]
}
