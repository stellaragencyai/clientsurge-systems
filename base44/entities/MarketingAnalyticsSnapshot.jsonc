{
  "name": "MarketingAnalyticsSnapshot",
  "type": "object",
  "title": "Marketing Analytics Snapshot",
  "description": "Real tracked metrics for a social post \u2014 social engagement, website traffic, leads, and conversions. No fabricated data.",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "platform": {
      "type": "string",
      "title": "Platform",
      "enum": [
        "linkedin",
        "tiktok",
        "instagram_business",
        "facebook_ads"
      ]
    },
    "post_id": {
      "type": "string",
      "title": "Post ID"
    },
    "impressions": {
      "type": "number",
      "title": "Impressions",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "title": "Clicks",
      "default": 0
    },
    "likes": {
      "type": "number",
      "title": "Likes",
      "default": 0
    },
    "comments": {
      "type": "number",
      "title": "Comments",
      "default": 0
    },
    "shares": {
      "type": "number",
      "title": "Shares",
      "default": 0
    },
    "saves": {
      "type": "number",
      "title": "Saves",
      "default": 0
    },
    "follows": {
      "type": "number",
      "title": "Follows",
      "default": 0
    },
    "website_sessions": {
      "type": "number",
      "title": "Website Sessions",
      "default": 0,
      "description": "GA4-tracked sessions attributed to this post's UTM URL"
    },
    "leads_created": {
      "type": "number",
      "title": "Leads Created",
      "default": 0,
      "description": "Leads captured from this post's UTM URL"
    },
    "conversion_rate": {
      "type": "number",
      "title": "Conversion Rate (%)",
      "default": 0
    },
    "captured_at": {
      "type": "string",
      "title": "Captured At",
      "format": "date-time"
    },
    "data_source": {
      "type": "string",
      "title": "Data Source",
      "enum": [
        "platform_api",
        "ga4",
        "lead_entity",
        "manual",
        "not_connected"
      ],
      "default": "not_connected",
      "description": "How this metric was obtained. 'not_connected' means data unavailable."
    }
  },
  "required": [
    "platform",
    "captured_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}