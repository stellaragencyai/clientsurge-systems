{
  "name": "NurtureCampaign",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "tenant_scope_error": {
      "type": "string",
      "title": "Tenant Scope Error"
    },
    "lead_name": {
      "type": "string",
      "title": "Lead Name"
    },
    "lead_email": {
      "type": "string",
      "title": "Lead Email"
    },
    "lead_business": {
      "type": "string",
      "title": "Lead Business"
    },
    "status": {
      "type": "string",
      "title": "Campaign Status",
      "enum": [
        "active",
        "paused",
        "completed",
        "stopped"
      ],
      "default": "active"
    },
    "stop_reason": {
      "type": "string",
      "title": "Stop Reason",
      "enum": [
        "qualified",
        "booked",
        "closed",
        "manual_pause",
        "opted_out",
        "completed_all_steps",
        "manual_stop"
      ]
    },
    "enrolled_at": {
      "type": "string",
      "title": "Enrolled At"
    },
    "last_step_run_at": {
      "type": "string",
      "title": "Last Step Run At"
    },
    "current_step": {
      "type": "number",
      "title": "Current Step (1-8)",
      "default": 0
    },
    "step1_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "title": "Day 1 \u2014 Welcome"
    },
    "step2_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "title": "Day 3 \u2014 Case Study"
    },
    "step3_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "title": "Day 7 \u2014 Testimonial"
    },
    "step4_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "title": "Day 10 \u2014 Tip"
    },
    "step5_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "title": "Day 14 \u2014 Case Study 2"
    },
    "step6_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "title": "Day 18 \u2014 Testimonial 2"
    },
    "step7_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "title": "Day 23 \u2014 Tip + Offer"
    },
    "step8_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "title": "Day 30 \u2014 Final CTA"
    },
    "step1_sent_at": {
      "type": "string",
      "title": "Day 1 Sent At"
    },
    "step2_sent_at": {
      "type": "string",
      "title": "Day 3 Sent At"
    },
    "step3_sent_at": {
      "type": "string",
      "title": "Day 7 Sent At"
    },
    "step4_sent_at": {
      "type": "string",
      "title": "Day 10 Sent At"
    },
    "step5_sent_at": {
      "type": "string",
      "title": "Day 14 Sent At"
    },
    "step6_sent_at": {
      "type": "string",
      "title": "Day 18 Sent At"
    },
    "step7_sent_at": {
      "type": "string",
      "title": "Day 23 Sent At"
    },
    "step8_sent_at": {
      "type": "string",
      "title": "Day 30 Sent At"
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "lead_id",
    "lead_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}