{
  "name": "TwilioGrowthEngineOperatorNote",
  "type": "object",
  "title": "Twilio Growth Engine Operator Note",
  "description": "Private admin-only manual observation attached to a capability row. Does NOT override computed status or make a capability trusted.",
  "properties": {
    "capability_key": {
      "type": "string",
      "title": "Capability Key",
      "description": "The capability key this note is attached to (e.g. instant_lead_response)"
    },
    "capability_label": {
      "type": "string",
      "title": "Capability Label"
    },
    "note_text": {
      "type": "string",
      "title": "Note Text",
      "maxLength": 2000
    },
    "author_email": {
      "type": "string",
      "title": "Author Email"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "is_observation_only": {
      "type": "boolean",
      "title": "Observation Only (No Status Override)",
      "default": true
    }
  },
  "required": [
    "capability_key",
    "note_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}