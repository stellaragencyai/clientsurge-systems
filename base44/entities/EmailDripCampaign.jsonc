{
  "name": "EmailDripCampaign",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "tenant_scope_error": {
      "type": "string",
      "title": "Tenant Scope Error"
    },
    "campaign_type": {
      "type": "string",
      "title": "Campaign Type",
      "enum": [
        "case_study",
        "testimonial",
        "pricing",
        "feature_highlight",
        "custom"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "paused",
        "completed",
        "failed"
      ],
      "default": "active"
    },
    "trigger_intent": {
      "type": "string",
      "title": "Triggered By Intent",
      "enum": [
        "asking_question",
        "pricing_concern",
        "uncertain",
        "booking_ready"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "number"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "delay_hours": {
            "type": "number"
          },
          "sent_at": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sent",
              "opened",
              "clicked",
              "failed"
            ]
          }
        }
      },
      "title": "Campaign Steps"
    },
    "enrolled_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email"
    },
    "total_opened": {
      "type": "number",
      "default": 0
    },
    "total_clicked": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "lead_id",
    "campaign_type",
    "trigger_intent"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}