{
  "type": "object",
  "name": "IdempotencyKey",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "idempotency_key": {
      "type": "string",
      "title": "Unique Idempotency Key"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "operation_type": {
      "type": "string",
      "title": "Operation Type",
      "enum": [
        "order_processing",
        "client_provisioning",
        "onboarding_workflow",
        "automation_rule_execution",
        "messaging_send",
        "subscription_update",
        "webhook_handling",
        "custom"
      ]
    },
    "resource_type": {
      "type": "string",
      "title": "Resource Type",
      "enum": [
        "order",
        "client",
        "client_project",
        "lead",
        "communication_event",
        "automation_rule",
        "stripe_event"
      ]
    },
    "resource_id": {
      "type": "string",
      "title": "Resource ID"
    },
    "status": {
      "type": "string",
      "title": "Processing Status",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "skipped"
      ],
      "default": "pending"
    },
    "result_hash": {
      "type": "string",
      "title": "Result Hash"
    },
    "execution_count": {
      "type": "integer",
      "title": "Execution Count",
      "default": 0
    },
    "first_executed_at": {
      "type": "string",
      "title": "First Executed At",
      "format": "date-time"
    },
    "last_executed_at": {
      "type": "string",
      "title": "Last Executed At",
      "format": "date-time"
    },
    "metadata_json": {
      "type": "string",
      "title": "Operation Metadata"
    },
    "error_message": {
      "type": "string",
      "title": "Last Error (if failed)"
    }
  },
  "required": [
    "idempotency_key",
    "operation_type",
    "resource_type"
  ],
  "_metadata": {
    "status": "ORCHESTRATION_LAYER",
    "reason": "Global deduplication tracking. Prevents duplicate execution of critical operations across all subsystems.",
    "tenant_scoped": "client_id + client_project_id (optional)",
    "documentation": "ORCHESTRATION_LAYER.md",
    "product_layer": "infrastructure",
    "system_layer": "orchestration",
    "visibility": "internal_only",
    "architecture_level": "reliability"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}