{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "name": {
      "type": "string",
      "title": "Campaign Name"
    },
    "subject": {
      "type": "string",
      "title": "Email Subject"
    },
    "body_html": {
      "type": "string",
      "title": "Email Body (HTML)"
    },
    "body_text": {
      "type": "string",
      "title": "Email Body (Plain Text)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "scheduled",
        "sending",
        "sent",
        "paused",
        "cancelled"
      ],
      "default": "draft"
    },
    "scheduled_at": {
      "type": "string",
      "title": "Scheduled Send Time"
    },
    "max_recipients": {
      "type": "number",
      "title": "Maximum Test Recipients",
      "default": 25
    },
    "follow_up_days": {
      "type": "number",
      "title": "Follow-Up Delay Days",
      "default": 3
    },
    "landing_page_url": {
      "type": "string",
      "title": "Landing Page URL"
    },
    "industry_sequence": {
      "type": "string",
      "title": "Industry Sequence",
      "enum": [
        "roofing",
        "hvac",
        "dental"
      ]
    },
    "sent_at": {
      "type": "string",
      "title": "Sent At"
    },
    "segment_filters": {
      "type": "object",
      "title": "Segment Filters (JSON)",
      "properties": {
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lead_score_min": {
          "type": "number"
        },
        "lead_score_max": {
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_recipients": {
          "type": "number"
        }
      }
    },
    "total_recipients": {
      "type": "number",
      "title": "Total Recipients",
      "default": 0
    },
    "suppressed_recipients": {
      "type": "number",
      "title": "Suppressed Recipients",
      "default": 0
    },
    "total_sent": {
      "type": "number",
      "title": "Total Sent",
      "default": 0
    },
    "total_delivered": {
      "type": "number",
      "title": "Total Delivered",
      "default": 0
    },
    "total_opened": {
      "type": "number",
      "title": "Total Opened",
      "default": 0
    },
    "total_clicked": {
      "type": "number",
      "title": "Total Clicked",
      "default": 0
    },
    "total_unsubscribed": {
      "type": "number",
      "title": "Total Unsubscribed",
      "default": 0
    },
    "total_bounced": {
      "type": "number",
      "title": "Total Bounced",
      "default": 0
    }
  },
  "required": [
    "name",
    "subject"
  ]
}
