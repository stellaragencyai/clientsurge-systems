{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)",
      "description": "Blank/null for global admin templates."
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "name": {
      "type": "string",
      "title": "Campaign Name"
    },
    "subject": {
      "type": "string",
      "title": "Email Subject"
    },
    "body_html": {
      "type": "string",
      "title": "Email Body (HTML)"
    },
    "body_text": {
      "type": "string",
      "title": "Email Body (Plain Text)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "scheduled",
        "sending",
        "sent",
        "paused",
        "cancelled"
      ],
      "default": "draft"
    },
    "scheduled_at": {
      "type": "string",
      "title": "Scheduled Send Time"
    },
    "max_recipients": {
      "type": "number",
      "title": "Maximum Test Recipients",
      "default": 25
    },
    "follow_up_days": {
      "type": "number",
      "title": "Follow-Up Delay Days",
      "default": 3
    },
    "landing_page_url": {
      "type": "string",
      "title": "Landing Page URL"
    },
    "industry_sequence": {
      "type": "string",
      "title": "Industry Sequence",
      "enum": [
        "roofing",
        "hvac",
        "dental"
      ]
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email",
      "description": "Resend from email for this campaign. Falls back to AdminSettings default if blank."
    },
    "sent_at": {
      "type": "string",
      "title": "Sent At"
    },
    "segment_filters": {
      "type": "object",
      "title": "Segment Filters (JSON)",
      "properties": {
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lead_score_min": {
          "type": "number"
        },
        "lead_score_max": {
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_recipients": {
          "type": "number"
        }
      }
    },
    "total_recipients": {
      "type": "number",
      "title": "Total Recipients",
      "default": 0
    },
    "suppressed_recipients": {
      "type": "number",
      "title": "Suppressed Recipients",
      "default": 0
    },
    "total_sent": {
      "type": "number",
      "title": "Total Sent",
      "default": 0
    },
    "total_delivered": {
      "type": "number",
      "title": "Total Delivered",
      "default": 0
    },
    "total_opened": {
      "type": "number",
      "title": "Total Opened",
      "default": 0
    },
    "total_clicked": {
      "type": "number",
      "title": "Total Clicked",
      "default": 0
    },
    "total_unsubscribed": {
      "type": "number",
      "title": "Total Unsubscribed",
      "default": 0
    },
    "total_bounced": {
      "type": "number",
      "title": "Total Bounced",
      "default": 0
    }
  },
  "required": [
    "name",
    "subject"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}