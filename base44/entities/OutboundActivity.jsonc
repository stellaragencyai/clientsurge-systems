{
  "name": "OutboundActivity",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "outbound_lead_id": {
      "type": "string",
      "title": "OutboundLead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "sequence_id": {
      "type": "string",
      "title": "Sequence ID"
    },
    "sequence_step": {
      "type": "integer",
      "title": "Sequence Step Number"
    },
    "activity_type": {
      "type": "string",
      "title": "Activity Type",
      "enum": [
        "message_sent",
        "message_delivered",
        "message_bounced",
        "message_opened",
        "link_clicked",
        "reply_received",
        "conversion_event",
        "sequence_paused",
        "sequence_completed"
      ]
    },
    "channel": {
      "type": "string",
      "title": "Channel",
      "enum": [
        "email",
        "sms",
        "linkedin"
      ]
    },
    "message_subject": {
      "type": "string",
      "title": "Message Subject"
    },
    "message_preview": {
      "type": "string",
      "title": "Message Preview"
    },
    "provider_message_id": {
      "type": "string",
      "title": "Provider Message ID"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "opened",
        "clicked"
      ]
    },
    "reply_text": {
      "type": "string",
      "title": "Reply Text (if reply received)"
    },
    "reply_sentiment": {
      "type": "string",
      "title": "Reply Sentiment",
      "enum": [
        "positive",
        "neutral",
        "negative",
        "unclassified"
      ]
    },
    "metadata_json": {
      "type": "string",
      "title": "Metadata",
      "description": "JSON: {open_time, click_time, click_url, etc}"
    },
    "occurred_at": {
      "type": "string",
      "title": "Occurred At",
      "format": "date-time"
    }
  },
  "required": [
    "outbound_lead_id",
    "activity_type",
    "occurred_at"
  ],
  "_metadata": {
    "status": "SALES_AUTOMATION",
    "reason": "Immutable event log tracking all outbound interactions (sends, opens, clicks, replies).",
    "immutable": true,
    "tenant_scoped": "client_id",
    "documentation": "SALES_AUTOMATION.md"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}