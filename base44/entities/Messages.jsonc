{
  "name": "Messages",
  "type": "object",
  "_metadata": {
    "status": "CORE_PRODUCTION",
    "reason": "Primary message storage. Immutable. Write in all message flows.",
    "immutable": true,
    "tenant_scoped": "client_id + client_project_id; unmatched inbound evidence allowed when tenant is not resolved yet"
  },
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "funnel_identity_id": {
      "type": "string",
      "title": "Unified Funnel Identity"
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal",
        "unmatched"
      ],
      "default": "missing_client_id"
    },
    "tenant_scope_error": {
      "type": "string",
      "title": "Tenant Scope Error"
    },
    "direction": {
      "type": "string",
      "title": "Direction",
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "channel": {
      "type": "string",
      "title": "Channel",
      "enum": [
        "sms",
        "email"
      ]
    },
    "message_text": {
      "type": "string",
      "title": "Message Text"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "received",
        "blocked",
        "skipped",
        "opt_out",
        "opt_out_unmatched",
        "received_unmatched"
      ]
    },
    "ai_generated": {
      "type": "boolean",
      "title": "AI Generated",
      "default": false
    },
    "delivery_status": {
      "type": "string",
      "title": "Delivery Status",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "blocked",
        "skipped"
      ]
    },
    "provider": {
      "type": "string",
      "title": "Provider",
      "enum": [
        "twilio",
        "resend",
        "internal",
        "internal_guardrail",
        "internal_compliance_guard"
      ]
    },
    "provider_message_id": {
      "type": "string",
      "title": "Provider Message ID"
    },
    "provider_from_number": {
      "type": "string",
      "title": "Provider From Number (SMS)",
      "description": "Twilio from number used for this send. Supports future per-client number assignment."
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email",
      "description": "Resend from email used for this send. Supports future per-client sending domain."
    },
    "from_address": {
      "type": "string",
      "title": "From Address"
    },
    "from_number": {
      "type": "string",
      "title": "From Number"
    },
    "from_phone": {
      "type": "string",
      "title": "From Phone"
    },
    "lead_phone": {
      "type": "string",
      "title": "Lead Phone"
    },
    "to_address": {
      "type": "string",
      "title": "To Address"
    },
    "metadata_json": {
      "type": "string",
      "title": "Metadata"
    }
  },
  "required": [
    "direction",
    "channel",
    "message_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        }
      ]
    }
  }
}
