{
  "name": "Messages",
  "type": "object",
  "_metadata": {
    "status": "CORE_PRODUCTION",
    "reason": "Primary message storage - canonical storage for message bodies, templates, transcripts. Immutable. Write in all message flows.",
    "immutable": true,
    "tenant_scoped": "client_id + client_project_id (with lead_id fallback for backward compat)",
    "documentation": "ARCHITECTURE_CONSOLIDATION.md"
  },
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "funnel_identity_id": {
      "type": "string",
      "title": "Unified Funnel Identity",
      "description": "Unique identifier representing a single customer journey (matches lead's funnel_identity_id)"
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)",
      "description": "Business/client tenant ID. Required for multi-client scaling."
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)",
      "description": "Project/workspace/install scope under this client."
    },
    "direction": {
      "type": "string",
      "title": "Direction",
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "channel": {
      "type": "string",
      "title": "Channel",
      "enum": [
        "sms",
        "email"
      ]
    },
    "message_text": {
      "type": "string",
      "title": "Message Text"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "sent",
        "delivered",
        "failed",
        "received"
      ]
    },
    "ai_generated": {
      "type": "boolean",
      "title": "AI Generated",
      "default": false
    },
    "delivery_status": {
      "type": "string",
      "title": "Delivery Status",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed"
      ]
    }
  },
  "required": [
    "lead_id",
    "direction",
    "channel",
    "message_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        }
      ]
    }
  }
}