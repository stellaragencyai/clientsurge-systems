{
  "name": "Client",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "website": {
      "type": "string",
      "title": "Website URL"
    },
    "social_media": {
      "type": "string",
      "title": "Instagram / Social Media Links"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Services Offered"
    },
    "lead_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Lead Sources"
    },
    "current_process": {
      "type": "string",
      "title": "Current Lead Handling Process"
    },
    "response_speed": {
      "type": "string",
      "title": "Response Speed",
      "enum": [
        "Immediately",
        "Within 1 hour",
        "Same day",
        "Longer"
      ]
    },
    "booking_link": {
      "type": "string",
      "title": "Booking Link"
    },
    "calendar_system": {
      "type": "string",
      "title": "Calendar System Used"
    },
    "requires_consultation": {
      "type": "string",
      "title": "Requires Consultation First",
      "enum": [
        "Yes",
        "No"
      ]
    },
    "brand_voice": {
      "type": "string",
      "title": "Brand Voice",
      "enum": [
        "Professional",
        "Friendly",
        "Luxury",
        "Casual"
      ]
    },
    "customer_questions": {
      "type": "string",
      "title": "Most Common Customer Questions"
    },
    "business_hours": {
      "type": "string",
      "title": "Business Hours"
    },
    "has_old_leads": {
      "type": "string",
      "title": "Has Old Leads",
      "enum": [
        "Yes",
        "No"
      ]
    },
    "access_info": {
      "type": "string",
      "title": "Access / Login Information"
    },
    "goals": {
      "type": "string",
      "title": "Success Goals"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Onboarding",
        "In Setup",
        "Active",
        "Completed"
      ],
      "default": "Onboarding"
    },
    "lifecycle_stage": {
      "type": "string",
      "title": "Lifecycle Stage",
      "enum": [
        "pending",
        "setup_in_progress",
        "testing",
        "live",
        "suspended"
      ],
      "default": "pending",
      "description": "Commercial lifecycle tracking: inferred from ClientProject status and setup completion"
    },
    "lifecycle_stage_override": {
      "type": "string",
      "title": "Lifecycle Override (Admin Only)",
      "enum": [
        "pending",
        "setup_in_progress",
        "testing",
        "live",
        "suspended"
      ],
      "description": "Manual admin override of lifecycle stage"
    },
    "lifecycle_override_by": {
      "type": "string",
      "title": "Lifecycle Override By (Admin Email)"
    },
    "lifecycle_override_at": {
      "type": "string",
      "title": "Lifecycle Override At",
      "format": "date-time"
    },
    "onboarding_started_at": {
      "type": "string",
      "title": "Onboarding Started At",
      "format": "date-time"
    },
    "setup_completed_at": {
      "type": "string",
      "title": "Setup Completed At",
      "format": "date-time"
    },
    "testing_started_at": {
      "type": "string",
      "title": "Testing Started At",
      "format": "date-time"
    },
    "testing_completed_at": {
      "type": "string",
      "title": "Testing Completed At",
      "format": "date-time"
    },
    "went_live_at": {
      "type": "string",
      "title": "Went Live At",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    },
    "crm_lead_id": {
      "type": "string",
      "title": "Linked CRM Lead ID"
    },
    "lead_id": {
      "type": "string",
      "title": "Linked Lead ID"
    },
    "website_lead_id": {
      "type": "string",
      "title": "Linked Website Lead ID"
    },
    "industry": {
      "type": "string",
      "title": "Industry"
    },
    "package_purchased": {
      "type": "string",
      "title": "Package Purchased"
    },
    "automation_services_selected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Automation Services Selected"
    },
    "current_crm_stack": {
      "type": "string",
      "title": "Current CRM / Tool Stack"
    },
    "google_business_profile_access": {
      "type": "string",
      "title": "Google Business Profile Access Instructions"
    },
    "website_access_instructions": {
      "type": "string",
      "title": "Website Access Instructions"
    },
    "twilio_phone_requirements": {
      "type": "string",
      "title": "Twilio / Phone Requirements"
    },
    "email_domain_access_requirements": {
      "type": "string",
      "title": "Email / Domain Access Requirements"
    },
    "notes": {
      "type": "string",
      "title": "Internal Setup Notes"
    }
  },
  "required": [
    "full_name",
    "business_name",
    "email",
    "phone"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}