{
  "name": "AutomationModule",
  "type": "object",
  "title": "Automation Module Registry",
  "description": "Global registry of every automation ClientSurge supports. Modules are industry-agnostic \u2014 industry-specific behavior is injected at runtime via IndustryConfig.",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "module_key": {
      "type": "string",
      "title": "Module Key",
      "description": "Unique identifier (e.g., 'instant_lead_response')"
    },
    "display_name": {
      "type": "string",
      "title": "Display Name"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "lead_capture",
        "nurture",
        "booking",
        "operations",
        "growth",
        "reactivation"
      ],
      "default": "lead_capture"
    },
    "min_package_tier": {
      "type": "string",
      "title": "Minimum Package Tier",
      "enum": [
        "starter",
        "growth",
        "pro"
      ],
      "default": "starter",
      "description": "Lowest tier that includes this module"
    },
    "dependencies": {
      "type": "array",
      "title": "Dependencies",
      "items": {
        "type": "string"
      },
      "description": "Other module_keys that must be activated before this one"
    },
    "default_module_params": {
      "type": "object",
      "title": "Default Module Parameters",
      "description": "Default configuration parameters for this module (overridden per-deployment)"
    },
    "trigger_type": {
      "type": "string",
      "title": "Trigger Type",
      "enum": [
        "event",
        "scheduled",
        "manual",
        "webhook"
      ],
      "default": "event"
    },
    "action_type": {
      "type": "string",
      "title": "Action Type",
      "description": "What this module does (e.g., 'send_sms', 'send_email', 'ai_call', 'create_task')"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "enabled",
        "disabled",
        "deprecated",
        "beta"
      ],
      "default": "enabled"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "module_key",
    "display_name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}