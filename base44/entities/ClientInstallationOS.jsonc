{
  "name": "ClientInstallationOS",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "client_email": {
      "type": "string",
      "title": "Client Email"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "workflow_stage": {
      "type": "string",
      "title": "Workflow Stage",
      "enum": [
        "intake_received",
        "website_building",
        "website_review",
        "website_approved",
        "website_live",
        "automation_setup",
        "automation_testing",
        "activation_ready",
        "activated"
      ],
      "default": "intake_received"
    },
    "website_project_id": {
      "type": "string",
      "title": "Website Project ID"
    },
    "website_status": {
      "type": "string",
      "title": "Website Status",
      "enum": [
        "not_started",
        "building",
        "review",
        "approved",
        "live"
      ],
      "default": "not_started"
    },
    "all_automations_checklists": {
      "type": "array",
      "title": "All Automation Checklist IDs",
      "items": {
        "type": "string"
      }
    },
    "activation_status": {
      "type": "string",
      "title": "Activation Status",
      "enum": [
        "not_ready",
        "ready_for_activation",
        "activating",
        "testing",
        "live",
        "blocked"
      ],
      "default": "not_ready",
      "description": "Current activation state: not_ready \u2192 ready_for_activation \u2192 activating \u2192 testing \u2192 live. blocked = unrecoverable issue."
    },
    "activation_eligible": {
      "type": "boolean",
      "title": "Eligible for Activation",
      "default": false,
      "description": "True if all required setup is complete and no blockers exist"
    },
    "activation_approved_at": {
      "type": "string",
      "title": "Activation Approved At",
      "format": "date-time"
    },
    "activation_approved_by": {
      "type": "string",
      "title": "Activation Approved By (Admin Email)"
    },
    "activation_override": {
      "type": "boolean",
      "title": "Override Activation Checks",
      "default": false,
      "description": "Admin can bypass readiness checks if necessary"
    },
    "activation_override_reason": {
      "type": "string",
      "title": "Override Reason"
    },
    "activation_override_by": {
      "type": "string",
      "title": "Override By (Admin Email)"
    },
    "missing_requirements": {
      "type": "array",
      "title": "Missing Setup Requirements",
      "items": {
        "type": "string"
      },
      "description": "List of unmet setup items (e.g., phone_number, booking_link, email_configured)"
    },
    "activation_blockers": {
      "type": "array",
      "title": "Activation Blockers",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "integration_error",
              "test_failed",
              "client_not_approved",
              "checklist_incomplete",
              "proof_missing"
            ]
          },
          "message": {
            "type": "string"
          },
          "identified_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Issues preventing activation"
    },
    "next_required_action": {
      "type": "object",
      "title": "Next Required Action",
      "properties": {
        "action_type": {
          "type": "string",
          "enum": [
            "configure_integration",
            "run_test",
            "get_client_approval",
            "complete_checklist",
            "contact_support",
            "ready_to_activate"
          ]
        },
        "description": {
          "type": "string"
        },
        "estimated_time_minutes": {
          "type": "integer"
        }
      },
      "description": "Single recommended next step to progress toward activation"
    },
    "integration_readiness": {
      "type": "object",
      "title": "Integration Readiness Status",
      "properties": {
        "sms_ready": {
          "type": "boolean",
          "title": "SMS Integration Ready"
        },
        "email_ready": {
          "type": "boolean",
          "title": "Email Integration Ready"
        },
        "booking_link_ready": {
          "type": "boolean",
          "title": "Booking Link Ready"
        },
        "lead_form_connected": {
          "type": "boolean",
          "title": "Lead Form Connected"
        },
        "webhooks_verified": {
          "type": "boolean",
          "title": "Webhooks Verified"
        }
      },
      "description": "Integration capability flags for visibility"
    },
    "checklist_completion_percent": {
      "type": "number",
      "title": "Checklist Completion %",
      "default": 0,
      "description": "Overall completion of all automation checklists (0-100)"
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Workflow Notes"
    },
    "last_readiness_check_at": {
      "type": "string",
      "title": "Last Readiness Check",
      "format": "date-time",
      "description": "When activation readiness was last evaluated"
    },
    "went_live_at": {
      "type": "string",
      "title": "Went Live At",
      "format": "date-time",
      "description": "When the client's automations went live"
    },
    "environment": {
      "type": "string",
      "title": "Environment",
      "enum": [
        "production",
        "qa",
        "smoke",
        "demo",
        "internal",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_excluded": {
      "type": "boolean",
      "title": "Excluded From Dashboard",
      "default": false
    },
    "dashboard_exclusion_reason": {
      "type": "string",
      "title": "Dashboard Exclusion Reason"
    },
    "dashboard_truth_status": {
      "type": "string",
      "title": "Dashboard Truth Status",
      "enum": [
        "trusted",
        "warning",
        "blocked",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_truth_notes": {
      "type": "string",
      "title": "Dashboard Truth Notes"
    }
  },
  "required": [
    "order_id",
    "client_email",
    "business_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
