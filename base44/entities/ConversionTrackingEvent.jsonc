{
  "name": "ConversionTrackingEvent",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "event_id": {
      "type": "string",
      "title": "Event ID",
      "description": "Unique identifier for this event"
    },
    "session_id": {
      "type": "string",
      "title": "Session ID",
      "description": "Browser session identifier"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID",
      "description": "Optional link to client project for later attribution"
    },
    "page_key": {
      "type": "string",
      "title": "Page Key",
      "enum": [
        "homepage",
        "med_spa",
        "dental",
        "hvac",
        "roofing",
        "contractors",
        "real_estate",
        "personal_injury",
        "plumbing",
        "chiropractic",
        "pricing"
      ],
      "description": "Which landing page triggered the event"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "page_view",
        "scroll_depth",
        "cta_click",
        "pricing_view",
        "checkout_click",
        "form_submit",
        "demo_booking_click"
      ],
      "description": "Type of conversion event"
    },
    "event_label": {
      "type": "string",
      "title": "Event Label",
      "description": "Human-readable label (e.g., 'Get Started Button', 'See Pricing')"
    },
    "timestamp": {
      "type": "string",
      "title": "Timestamp",
      "format": "date-time",
      "description": "When the event occurred"
    },
    "metadata": {
      "type": "object",
      "title": "Metadata",
      "description": "Additional context about the event",
      "properties": {
        "device_type": {
          "type": "string",
          "enum": [
            "mobile",
            "tablet",
            "desktop"
          ]
        },
        "browser": {
          "type": "string"
        },
        "utm_source": {
          "type": "string"
        },
        "utm_medium": {
          "type": "string"
        },
        "utm_campaign": {
          "type": "string"
        },
        "utm_content": {
          "type": "string"
        },
        "referrer": {
          "type": "string"
        },
        "scroll_depth": {
          "type": "integer",
          "description": "Scroll depth percentage (0-100)"
        }
      }
    }
  },
  "required": [
    "event_id",
    "session_id",
    "page_key",
    "event_type",
    "timestamp"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}