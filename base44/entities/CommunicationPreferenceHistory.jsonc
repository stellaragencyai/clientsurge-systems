{
  "type": "object",
  "name": "CommunicationPreferenceHistory",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "client_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "consent_version": {
      "type": "string"
    },
    "previous_preferences_json": {
      "type": "string"
    },
    "current_preferences_json": {
      "type": "string"
    },
    "changed_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "changed_by_user_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    }
  },
  "required": [
    "source",
    "current_preferences_json",
    "changed_at"
  ],
  "indexes": [
    {
      "fields": [
        "client_id",
        "changed_at"
      ]
    },
    {
      "fields": [
        "user_email",
        "changed_at"
      ]
    }
  ]
}