{
  "name": "AutomationRule",
  "type": "object",
  "_metadata": {
    "status": "CORE_AUTOMATION",
    "reason": "Primary automation execution system - conditional trigger + action rules.",
    "tier": "PRIMARY"
  },
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "rule_name": {
      "type": "string",
      "title": "Rule Name"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)",
      "description": "Blank/null for global admin rules."
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "system_internal"
    },
    "enabled": {
      "type": "boolean",
      "title": "Enabled",
      "default": true
    },
    "trigger_type": {
      "type": "string",
      "title": "Trigger Type",
      "enum": [
        "lead_created",
        "lead_replied",
        "lead_scored",
        "daily_rescore",
        "churn_check"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [
              "equals",
              "greater_than",
              "less_than",
              "contains",
              "in_range"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      },
      "title": "Conditions"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_type": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      },
      "title": "Actions to Execute"
    },
    "priority": {
      "type": "number",
      "title": "Priority",
      "default": 0
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    },
    "last_fired_at": {
      "type": "string",
      "title": "Last Fired At"
    }
  },
  "required": [
    "rule_name",
    "project_id",
    "trigger_type",
    "conditions",
    "actions"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        },
        {
          "data.tenant_scope_status": "system_internal"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}