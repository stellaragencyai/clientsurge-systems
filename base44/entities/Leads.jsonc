{
  "name": "Leads",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "business_type": {
      "type": "string",
      "title": "Business Type"
    },
    "problem": {
      "type": "string",
      "title": "Biggest Problem"
    },
    "source": {
      "type": "string",
      "title": "Lead Source"
    },
    "intake_type": {
      "type": "string",
      "title": "Intake Type"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "New",
        "Contacted",
        "Replied",
        "Qualified",
        "Booking Prompt Sent",
        "Booked",
        "Closed"
      ],
      "default": "New"
    },
    "lead_score": {
      "type": "number",
      "title": "Lead Score (0-100)",
      "default": 0
    },
    "last_contacted_at": {
      "type": "string",
      "title": "Last Contacted At"
    },
    "next_follow_up_at": {
      "type": "string",
      "title": "Next Follow-Up At"
    },
    "booking_link_sent_at": {
      "type": "string",
      "title": "Booking Link Sent At"
    },
    "booked_at": {
      "type": "string",
      "title": "Booked At"
    },
    "ai_intent": {
      "type": "string",
      "title": "AI Intent",
      "enum": [
        "question",
        "pricing_interest",
        "availability_interest",
        "booking_ready",
        "unsure",
        "not_interested",
        "stop",
        "other"
      ],
      "default": "other"
    },
    "ai_last_classification": {
      "type": "string",
      "title": "Last AI Classification"
    },
    "ai_confidence": {
      "type": "number",
      "title": "Last Classification Confidence",
      "default": 0
    },
    "normalized_email": {
      "type": "string",
      "title": "Normalized Email"
    },
    "normalized_phone": {
      "type": "string",
      "title": "Normalized Phone"
    },
    "normalized_business_name": {
      "type": "string",
      "title": "Normalized Business Name"
    },
    "dedupe_key": {
      "type": "string",
      "title": "Dedupe Key"
    },
    "import_source": {
      "type": "string",
      "title": "Import Source"
    },
    "import_batch_id": {
      "type": "string",
      "title": "Import Batch ID"
    },
    "last_activity_at": {
      "type": "string",
      "title": "Last Activity At"
    }
  },
  "required": [
    "full_name",
    "business_name",
    "email",
    "phone",
    "business_type",
    "problem"
  ]
}
