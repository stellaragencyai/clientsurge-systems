// CUSTOMER-CANONICAL
// This is the canonical paid-customer CRM / automation lead model.
// Launch-critical customer runtime must use Leads, not Lead or WebsiteLead.
{
  "name": "Leads",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "order_id": {
      "type": "string",
      "title": "Paid Order ID"
    },
    "client_id": {
      "type": "string",
      "title": "Linked Client ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Linked Client Project ID"
    },
    "onboarding_client_id": {
      "type": "string",
      "title": "Linked Onboarding Client ID"
    },
    "business_type": {
      "type": "string",
      "title": "Business Type"
    },
    "problem": {
      "type": "string",
      "title": "Biggest Problem"
    },
    "source": {
      "type": "string",
      "title": "Lead Source"
    },
    "intake_type": {
      "type": "string",
      "title": "Intake Type"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "New",
        "Contacted",
        "Replied",
        "Qualified",
        "Booking Prompt Sent",
        "Booked",
        "Closed"
      ],
      "default": "New"
    },
    "lead_score": {
      "type": "number",
      "title": "Lead Score (0-100)",
      "default": 0
    },
    "activation_priority": {
      "type": "string",
      "title": "Activation Priority",
      "enum": [
        "Hot",
        "High",
        "Medium",
        "Low"
      ],
      "default": "Low"
    },
    "lead_category": {
      "type": "string",
      "title": "Lead Category",
      "enum": [
        "High-Value",
        "Standard"
      ],
      "default": "Standard"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To (User Email)"
    },
    "assigned_at": {
      "type": "string",
      "title": "Assigned At"
    },
    "assigned_agent_name": {
      "type": "string",
      "title": "Assigned AI Agent Name",
      "description": "Name of the industry-specific AI sales agent handling this lead (e.g. sales_rep_med_spa)"
    },
    "last_contacted_at": {
      "type": "string",
      "title": "Last Contacted At"
    },
    "next_follow_up_at": {
      "type": "string",
      "title": "Next Follow-Up At"
    },
    "booking_link_sent_at": {
      "type": "string",
      "title": "Booking Link Sent At"
    },
    "booked_at": {
      "type": "string",
      "title": "Booked At"
    },
    "last_activity_at": {
      "type": "string",
      "title": "Last Activity At"
    },
    "reply_sentiment": {
      "type": "string",
      "title": "Reply Sentiment (AI)",
      "enum": [
        "Positive",
        "Neutral",
        "Negative",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "reply_sentiment_reason": {
      "type": "string",
      "title": "Sentiment Reason (AI)"
    },
    "reply_sentiment_analyzed_at": {
      "type": "string",
      "title": "Sentiment Last Analyzed At"
    },
    "ai_intent": {
      "type": "string",
      "title": "AI Intent",
      "enum": [
        "question",
        "pricing_interest",
        "availability_interest",
        "booking_ready",
        "unsure",
        "not_interested",
        "stop",
        "other"
      ],
      "default": "other"
    },
    "ai_last_classification": {
      "type": "string",
      "title": "Last AI Classification"
    },
    "ai_confidence": {
      "type": "number",
      "title": "Last Classification Confidence",
      "default": 0
    },
    "website": {
      "type": "string",
      "title": "Business Website URL"
    },
    "normalized_email": {
      "type": "string",
      "title": "Normalized Email"
    },
    "normalized_phone": {
      "type": "string",
      "title": "Normalized Phone"
    },
    "normalized_business_name": {
      "type": "string",
      "title": "Normalized Business Name"
    },
    "dedupe_key": {
      "type": "string",
      "title": "Dedupe Key"
    },
    "automation_context_json": {
      "type": "string",
      "title": "Automation Context JSON"
    },
    "import_source": {
      "type": "string",
      "title": "Import Source"
    },
    "import_batch_id": {
      "type": "string",
      "title": "Import Batch ID"
    },
    "industry_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Industry Tags (enriched)"
    },
    "company_size": {
      "type": "string",
      "title": "Company Size (enriched)",
      "enum": [
        "solo",
        "small",
        "medium",
        "large",
        "unknown"
      ],
      "default": "unknown"
    },
    "social_profiles": {
      "type": "object",
      "title": "Social Profiles (enriched)",
      "properties": {
        "instagram": {
          "type": "string"
        },
        "facebook": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        },
        "twitter": {
          "type": "string"
        }
      }
    },
    "enrichment_notes": {
      "type": "string",
      "title": "Enrichment Summary"
    },
    "enriched_at": {
      "type": "string",
      "title": "Last Enriched At"
    },
    "missed_call_step_sent": {
      "type": "integer",
      "title": "Missed-Call Follow-Up Step (1-4)",
      "default": 0,
      "description": "Highest follow-up step sent (0=none, 1=2min SMS, 2=10min email, 3=1hr SMS, 4=24hr email)"
    },
    "missed_call_last_step_at": {
      "type": "string",
      "title": "Missed-Call Last Step Sent At"
    },
    "missed_call_sequence_complete": {
      "type": "boolean",
      "title": "Missed-Call Sequence Complete",
      "default": false
    },
    "voice_call_attempted": {
      "type": "boolean",
      "title": "Voice Call Attempted",
      "default": false,
      "description": "True if an ElevenLabs voice call was attempted for this lead"
    },
    "voice_call_outcome": {
      "type": "string",
      "title": "Voice Call Outcome",
      "enum": [
        "answered",
        "no_answer",
        "busy",
        "failed",
        "not_attempted"
      ],
      "default": "not_attempted"
    }
  },
  "required": [
    "full_name",
    "business_name",
    "email",
    "phone",
    "business_type",
    "problem"
  ]
}
