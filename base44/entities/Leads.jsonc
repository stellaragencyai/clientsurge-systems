{
  "name": "Leads",
  "type": "object",
  "_metadata": {
    "status": "CORE_PRODUCTION",
    "reason": "Primary CRM entity - canonical system of record for all leads/contacts.",
    "tenant_scoped": "client_id + client_project_id"
  },
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "funnel_identity_id": {
      "type": "string",
      "title": "Unified Funnel Identity"
    },
    "canonical_lead_id": {
      "type": "string",
      "title": "Canonical Lead ID",
      "description": "Unique identifier derived from email/phone/business_name for deduplication"
    },
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "owner_contact_name": {
      "type": "string",
      "title": "Owner / Contact Name"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "business_type": {
      "type": "string",
      "title": "Business Type"
    },
    "industry": {
      "type": "string",
      "title": "Industry"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "problem": {
      "type": "string",
      "title": "Biggest Problem"
    },
    "source": {
      "type": "string",
      "title": "Lead Source"
    },
    "source_page": {
      "type": "string",
      "title": "Source Page"
    },
    "source_history": {
      "type": "array",
      "title": "Source Attribution History",
      "items": {
        "type": "string"
      }
    },
    "utm_source": {
      "type": "string",
      "title": "UTM Source"
    },
    "utm_medium": {
      "type": "string",
      "title": "UTM Medium"
    },
    "utm_campaign": {
      "type": "string",
      "title": "UTM Campaign"
    },
    "utm_content": {
      "type": "string",
      "title": "UTM Content"
    },
    "utm_term": {
      "type": "string",
      "title": "UTM Term"
    },
    "intake_type": {
      "type": "string",
      "title": "Intake Type"
    },
    "website_lead_id": {
      "type": "string",
      "title": "Linked Website Lead ID"
    },
    "order_id": {
      "type": "string",
      "title": "Linked Won Order ID"
    },
    "consent_given": {
      "type": "boolean",
      "title": "Consent Given",
      "default": false
    },
    "consent_given_at": {
      "type": "string",
      "title": "Consent Given At",
      "format": "date-time"
    },
    "consent_ip": {
      "type": "string",
      "title": "Consent IP Address"
    },
    "consent_source": {
      "type": "string",
      "title": "Consent Source"
    },
    "consent_text_version": {
      "type": "string",
      "title": "Consent Text Version"
    },
    "requested_channels": {
      "type": "array",
      "title": "Requested Contact Channels",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "New",
        "Contacted",
        "Replied",
        "Qualified",
        "Booking Prompt Sent",
        "Booked",
        "Closed"
      ],
      "default": "New"
    },
    "crm_stage": {
      "type": "string",
      "title": "CRM Stage",
      "enum": [
        "Not Contacted",
        "Contacted",
        "Opened / Clicked",
        "Replied",
        "Audit Booked",
        "Audit Completed",
        "Proposal Sent",
        "Won Pending Payment",
        "Won",
        "Lost",
        "Follow Up Later"
      ],
      "default": "Not Contacted"
    },
    "lead_state": {
      "type": "string",
      "title": "Lead Lifecycle State",
      "enum": [
        "NEW",
        "UNQUALIFIED",
        "QUALIFIED",
        "ENGAGED",
        "HOT",
        "BOOKED",
        "WON",
        "LOST",
        "DORMANT"
      ],
      "default": "NEW",
      "description": "Canonical lifecycle state \u2014 every lead has exactly one"
    },
    "outreach_status": {
      "type": "string",
      "title": "Outreach Status",
      "enum": [
        "not_contacted",
        "contacted",
        "replied",
        "booked",
        "do_not_contact",
        "bounced"
      ],
      "default": "not_contacted"
    },
    "do_not_contact": {
      "type": "boolean",
      "title": "Do Not Contact",
      "default": false
    },
    "email_unsubscribed": {
      "type": "boolean",
      "title": "Email Unsubscribed",
      "default": false
    },
    "email_bounced": {
      "type": "boolean",
      "title": "Email Bounced",
      "default": false
    },
    "lead_score": {
      "type": "number",
      "title": "Lead Score (0-100)",
      "default": 0
    },
    "activation_priority": {
      "type": "string",
      "title": "Activation Priority",
      "enum": [
        "Hot",
        "High",
        "Medium",
        "Low"
      ],
      "default": "Low"
    },
    "lead_category": {
      "type": "string",
      "title": "Lead Category",
      "enum": [
        "High-Value",
        "Standard"
      ],
      "default": "Standard"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To (User Email)"
    },
    "assigned_at": {
      "type": "string",
      "title": "Assigned At"
    },
    "assigned_agent_name": {
      "type": "string",
      "title": "Assigned AI Agent Name"
    },
    "last_contacted_at": {
      "type": "string",
      "title": "Last Contacted At"
    },
    "last_contacted_date": {
      "type": "string",
      "title": "Last Contacted Date"
    },
    "next_follow_up_at": {
      "type": "string",
      "title": "Next Follow-Up At"
    },
    "follow_up_date": {
      "type": "string",
      "title": "Follow-Up Date"
    },
    "booking_link_sent_at": {
      "type": "string",
      "title": "Booking Link Sent At"
    },
    "booked_at": {
      "type": "string",
      "title": "Booked At"
    },
    "last_outreach_campaign_id": {
      "type": "string",
      "title": "Last Outreach Campaign ID"
    },
    "last_outreach_subject": {
      "type": "string",
      "title": "Last Outreach Subject"
    },
    "landing_page_url": {
      "type": "string",
      "title": "Last Outreach Landing Page"
    },
    "page_submitted_from": {
      "type": "string",
      "title": "Page Submitted From"
    },
    "package_interest": {
      "type": "string",
      "title": "Package Interest"
    },
    "payment_source": {
      "type": "string",
      "title": "Payment Source",
      "enum": [
        "stripe",
        "manual_payment",
        "invoice_pending",
        "order_required"
      ]
    },
    "manual_payment_recorded_at": {
      "type": "string",
      "title": "Manual Payment Recorded At"
    },
    "manual_payment_recorded_by": {
      "type": "string",
      "title": "Manual Payment Recorded By"
    },
    "onboarding_blocked_reason": {
      "type": "string",
      "title": "Onboarding Blocked Reason"
    },
    "crm_tag": {
      "type": "string",
      "title": "CRM Tag"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "reply_sentiment": {
      "type": "string",
      "title": "Reply Sentiment (AI)",
      "enum": [
        "Positive",
        "Neutral",
        "Negative",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "reply_sentiment_reason": {
      "type": "string",
      "title": "Sentiment Reason (AI)"
    },
    "reply_sentiment_analyzed_at": {
      "type": "string",
      "title": "Sentiment Last Analyzed At"
    },
    "ai_intent": {
      "type": "string",
      "title": "AI Intent",
      "enum": [
        "question",
        "pricing_interest",
        "availability_interest",
        "booking_ready",
        "unsure",
        "not_interested",
        "stop",
        "other"
      ],
      "default": "other"
    },
    "ai_last_classification": {
      "type": "string",
      "title": "Last AI Classification"
    },
    "ai_confidence": {
      "type": "number",
      "title": "Last Classification Confidence",
      "default": 0
    },
    "website": {
      "type": "string",
      "title": "Business Website URL"
    },
    "website_url": {
      "type": "string",
      "title": "Website URL"
    },
    "industry_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Industry Tags (enriched)"
    },
    "normalized_email": {
      "type": "string",
      "title": "Normalized Email",
      "description": "Lowercase, trimmed email for deduplication"
    },
    "normalized_phone": {
      "type": "string",
      "title": "Normalized Phone",
      "description": "Digits only, standardized phone for deduplication"
    },
    "normalized_business_name": {
      "type": "string",
      "title": "Normalized Business Name",
      "description": "Lowercase, trimmed business name for deduplication"
    },
    "normalized_domain": {
      "type": "string",
      "title": "Normalized Domain",
      "description": "Domain extracted from email/website for deduplication"
    },
    "dedupe_key": {
      "type": "string",
      "title": "Deduplication Key"
    },
    "dedupe_status": {
      "type": "string",
      "title": "Deduplication Status",
      "enum": [
        "unique",
        "keeper",
        "duplicate_candidate",
        "merged_duplicate",
        "manual_review"
      ]
    },
    "dedupe_duplicate_of": {
      "type": "string",
      "title": "Duplicate Of Lead ID"
    },
    "dedupe_group_key": {
      "type": "string",
      "title": "Deduplication Group Key"
    },
    "dedupe_merged_ids": {
      "type": "array",
      "title": "Merged Duplicate Lead IDs",
      "items": {
        "type": "string"
      }
    },
    "dedupe_marked_at": {
      "type": "string",
      "title": "Deduplication Marked At"
    },
    "import_source": {
      "type": "string",
      "title": "Import Source"
    },
    "import_batch_id": {
      "type": "string",
      "title": "Import Batch ID"
    },
    "last_activity_at": {
      "type": "string",
      "title": "Last Activity At"
    },
    "company_size": {
      "type": "string",
      "title": "Company Size (enriched)",
      "enum": [
        "solo",
        "small",
        "medium",
        "large",
        "unknown"
      ],
      "default": "unknown"
    },
    "social_profiles": {
      "type": "object",
      "title": "Social Profiles (enriched)",
      "properties": {
        "instagram": {
          "type": "string"
        },
        "facebook": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        },
        "twitter": {
          "type": "string"
        }
      }
    },
    "enrichment_notes": {
      "type": "string",
      "title": "Enrichment Summary"
    },
    "enriched_at": {
      "type": "string",
      "title": "Last Enriched At"
    },
    "missed_call_step_sent": {
      "type": "integer",
      "title": "Missed-Call Follow-Up Step (1-4)",
      "default": 0
    },
    "missed_call_last_step_at": {
      "type": "string",
      "title": "Missed-Call Last Step Sent At"
    },
    "missed_call_sequence_complete": {
      "type": "boolean",
      "title": "Missed-Call Sequence Complete",
      "default": false
    },
    "voice_call_attempted": {
      "type": "boolean",
      "title": "Voice Call Attempted",
      "default": false
    },
    "voice_call_outcome": {
      "type": "string",
      "title": "Voice Call Outcome",
      "enum": [
        "answered",
        "no_answer",
        "busy",
        "failed",
        "not_attempted"
      ],
      "default": "not_attempted"
    },
    "voice_call_followup_sent": {
      "type": "boolean",
      "title": "Voice Call Follow-Up Sent",
      "default": false
    },
    "intent_score": {
      "type": "number",
      "title": "Intent Score (0-100)",
      "default": 0
    },
    "recency_score": {
      "type": "number",
      "title": "Recency Score (0-100)",
      "default": 0
    },
    "engagement_score": {
      "type": "number",
      "title": "Engagement Score (0-100)",
      "default": 0,
      "description": "Derived from opens, clicks, replies"
    },
    "segment_label": {
      "type": "string",
      "title": "Segment Label",
      "enum": [
        "HOT",
        "WARM",
        "COLD"
      ],
      "description": "Lead segment: HOT (80-100), WARM (50-79), COLD (0-49)"
    },
    "intelligence_score": {
      "type": "number",
      "title": "Intelligence Score (0-100)",
      "default": 0,
      "description": "AI-computed score combining lead_score, CRM stage, engagement, and recency"
    },
    "intelligence_segment": {
      "type": "string",
      "title": "Intelligence Segment",
      "enum": [
        "HOT_LEADS",
        "HIGH_INTENT",
        "NURTURE",
        "ENGAGED",
        "DORMANT",
        "COLD"
      ],
      "description": "Auto-segmentation by Lead Intelligence Layer"
    },
    "segment": {
      "type": "string",
      "title": "Segment (from Intelligence Score)",
      "enum": [
        "HOT",
        "HIGH_INTENT",
        "ENGAGED",
        "NURTURE",
        "DORMANT",
        "LOST"
      ],
      "description": "Derived from intelligence_score: 80-100=HOT, 65-79=HIGH_INTENT, 50-64=ENGAGED, 30-49=NURTURE, 1-29=DORMANT, 0=LOST"
    },
    "score_breakdown": {
      "type": "object",
      "title": "Score Breakdown",
      "description": "Admin visibility into score components",
      "properties": {
        "engagement_component": {
          "type": "number"
        },
        "intent_component": {
          "type": "number"
        },
        "recency_component": {
          "type": "number"
        },
        "stage_component": {
          "type": "number"
        },
        "source_quality_component": {
          "type": "number"
        },
        "website_presence_component": {
          "type": "number"
        }
      }
    },
    "revenue_impact_estimate": {
      "type": "number",
      "title": "Revenue Impact Estimate ($)",
      "default": 0,
      "description": "Estimated revenue potential based on intelligence score"
    }
  },
  "required": [
    "full_name",
    "business_name",
    "email",
    "phone",
    "business_type",
    "problem"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}