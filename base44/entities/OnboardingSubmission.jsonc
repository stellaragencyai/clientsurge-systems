{
  "name": "OnboardingSubmission",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "submission_data": {
      "type": "object",
      "title": "Form Data"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "submitted",
        "reviewed",
        "in_setup",
        "completed"
      ],
      "default": "submitted"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To (Admin)"
    }
  },
  "required": [
    "client_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}