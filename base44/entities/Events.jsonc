{
  "name": "Events",
  "type": "object",
  "_metadata": {
    "status": "DEPRECATED",
    "reason": "Replaced by CommunicationEvent (canonical event log). Use CommunicationEvent for all new flows. This entity is read-only legacy.",
    "sunset_date": "2026-09-30",
    "replacement": "CommunicationEvent",
    "read_only": true,
    "documentation": "ARCHITECTURE_CONSOLIDATION.md"
  },
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "lead_created",
        "sms_sent",
        "sms_received",
        "email_sent",
        "email_opened",
        "email_clicked",
        "status_changed",
        "follow_up_scheduled"
      ]
    },
    "data": {
      "type": "object",
      "title": "Event Data"
    }
  },
  "required": [
    "lead_id",
    "event_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.lead_id": {
            "$in": [
              "{{user.id}}",
              "{{user.data.linked_lead_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}