{
  "name": "BusinessConfigTemplate",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "industry": {
      "type": "string",
      "title": "Industry Type",
      "enum": [
        "med_spa",
        "dental",
        "hvac",
        "chiropractic",
        "roofing",
        "contractors"
      ],
      "description": "Industry this template is for"
    },
    "template_name": {
      "type": "string",
      "title": "Template Name",
      "description": "e.g. 'Med Spa Standard', 'Dental Express'"
    },
    "response_sla_minutes": {
      "type": "number",
      "title": "Response SLA (minutes)",
      "default": 60,
      "description": "Target response time in minutes"
    },
    "booking_frequency_days": {
      "type": "number",
      "title": "Typical Booking Frequency (days)",
      "default": 45,
      "description": "How often customers typically rebook"
    },
    "default_templates": {
      "type": "object",
      "title": "Default Message Templates",
      "properties": {
        "instant_response": {
          "type": "string"
        },
        "price_concern": {
          "type": "string"
        },
        "uncertain": {
          "type": "string"
        },
        "booking_reminder_24h": {
          "type": "string"
        },
        "booking_reminder_2h": {
          "type": "string"
        },
        "review_request": {
          "type": "string"
        },
        "reactivation_offer": {
          "type": "string"
        }
      }
    },
    "scoring_multipliers": {
      "type": "object",
      "title": "Lead Scoring Multipliers",
      "properties": {
        "source_phone": {
          "type": "number",
          "default": 1.2
        },
        "source_form": {
          "type": "number",
          "default": 1.0
        },
        "source_referral": {
          "type": "number",
          "default": 1.3
        },
        "response_under_5min": {
          "type": "number",
          "default": 1.2
        },
        "viewed_booking_page": {
          "type": "number",
          "default": 1.3
        },
        "premium_service": {
          "type": "number",
          "default": 1.1
        }
      },
      "description": "Multipliers applied to lead score calculation"
    },
    "routing_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Team Routing Rules",
      "description": "Rules for assigning leads to team members"
    },
    "churn_baseline_days": {
      "type": "number",
      "title": "Churn Baseline (days)",
      "default": 45,
      "description": "Days before flagging customer as churn risk"
    },
    "automation_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_name": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "delay_minutes": {
            "type": "number"
          }
        }
      },
      "title": "Automation Steps",
      "description": "Default automation workflow for this industry"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "industry",
    "template_name",
    "default_templates"
  ]
}