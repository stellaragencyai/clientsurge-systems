{
  "name": "ABTestVariant",
  "type": "object",
  "_metadata": {
    "status": "A/B_TESTING",
    "reason": "Stores A/B test variants for landing pages and industry pages. Enables performance comparison across page versions.",
    "tenant_scoped": "client_project_id (optional for global tests)",
    "documentation": "AB_TESTING_SYSTEM.md",
    "product_layer": "conversion_optimization"
  },
  "properties": {
    "page_key": {
      "type": "string",
      "title": "Page Key",
      "description": "Unique identifier for page being tested (e.g., 'homepage', 'hvac_landing', 'roofing_landing', 'dental_landing', 'chiropractic_landing')",
      "required": true
    },
    "page_path": {
      "type": "string",
      "title": "Page Route Path",
      "description": "React Router path (e.g., '/', '/hvac', '/roofing')"
    },
    "variant_label": {
      "type": "string",
      "title": "Variant Label",
      "enum": [
        "A",
        "B"
      ],
      "required": true,
      "description": "A = control/original, B = variation"
    },
    "variant_name": {
      "type": "string",
      "title": "Variant Name",
      "description": "Human-readable name (e.g., 'Original Hero Section', 'Value-Focused CTA')"
    },
    "variant_description": {
      "type": "string",
      "title": "Variant Description",
      "maxLength": 500,
      "description": "What changed in this variant (copy, layout, colors, CTA placement, etc.)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed"
      ],
      "default": "draft",
      "description": "draft=not started, active=collecting data, paused=suspended, completed=test ended"
    },
    "traffic_split_percent": {
      "type": "number",
      "title": "Traffic Split %",
      "default": 50,
      "description": "Percentage of traffic sent to this variant (A + B should = 100%)"
    },
    "start_date": {
      "type": "string",
      "title": "Test Start Date",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "title": "Test End Date",
      "format": "date-time"
    },
    "test_duration_days": {
      "type": "integer",
      "title": "Test Duration (days)",
      "default": 14,
      "description": "Planned duration of A/B test"
    },
    "changes": {
      "type": "object",
      "title": "Changes from Control",
      "properties": {
        "hero_title": {
          "type": "string",
          "title": "Hero Title (if changed)"
        },
        "cta_text": {
          "type": "string",
          "title": "CTA Button Text (if changed)"
        },
        "cta_color": {
          "type": "string",
          "title": "CTA Color (hex code if changed)"
        },
        "hero_subheading": {
          "type": "string",
          "title": "Hero Subheading (if changed)"
        },
        "value_proposition": {
          "type": "string",
          "title": "Value Proposition (if changed)"
        },
        "layout_change": {
          "type": "string",
          "title": "Layout Changes"
        },
        "other_changes": {
          "type": "array",
          "title": "Other Changes",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hypothesis": {
      "type": "string",
      "title": "Test Hypothesis",
      "maxLength": 500,
      "description": "What we're testing and why (e.g., 'Shorter headline increases click-through rate')"
    },
    "success_metric": {
      "type": "string",
      "title": "Primary Success Metric",
      "enum": [
        "conversion_rate",
        "click_through_rate",
        "lead_submission_rate",
        "booking_rate"
      ],
      "description": "Which metric determines winner"
    },
    "minimum_sample_size": {
      "type": "integer",
      "title": "Minimum Sample Size",
      "default": 100,
      "description": "Minimum visitors per variant for statistical significance"
    },
    "confidence_threshold_percent": {
      "type": "number",
      "title": "Confidence Threshold %",
      "default": 95,
      "description": "Statistical significance threshold (95% = 95% confident result is not due to chance)"
    },
    "winner": {
      "type": "string",
      "title": "Test Winner",
      "enum": [
        "A",
        "B",
        "tie",
        "undecided"
      ],
      "description": "Which variant won (determined after test completion)"
    },
    "winner_lift_percent": {
      "type": "number",
      "title": "Winner Lift %",
      "description": "Improvement of winner vs control (e.g., 15.3% better)"
    },
    "notes": {
      "type": "string",
      "title": "Test Notes",
      "description": "Observations, issues, or findings from test"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (optional)",
      "description": "Link to specific client if testing their industry pages"
    }
  },
  "required": [
    "page_key",
    "variant_label"
  ]
}