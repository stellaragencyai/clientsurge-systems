{
  "name": "ClientAccountConfig",
  "type": "object",
  "_metadata": {
    "status": "SAAS_SCALING",
    "reason": "Per-client workspace configuration, plan management, feature flags, and usage tracking for multi-tenant SaaS architecture.",
    "tenant_scoped": "client_id"
  },
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "client_email": {
      "type": "string",
      "title": "Client Admin Email"
    },
    "industry": {
      "type": "string",
      "title": "Industry"
    },
    "plan_type": {
      "type": "string",
      "title": "Plan Type",
      "enum": [
        "starter_system",
        "growth_system",
        "pro_system",
        "enterprise",
        "trial"
      ],
      "default": "starter_system"
    },
    "plan_status": {
      "type": "string",
      "title": "Plan Status",
      "enum": [
        "active",
        "trial",
        "paused",
        "cancelled",
        "past_due"
      ],
      "default": "trial"
    },
    "plan_started_at": {
      "type": "string",
      "title": "Plan Started At",
      "format": "date-time"
    },
    "trial_ends_at": {
      "type": "string",
      "title": "Trial Ends At",
      "format": "date-time"
    },
    "feature_flags": {
      "type": "object",
      "title": "Feature Flags",
      "description": "Per-client feature access flags",
      "properties": {
        "sms_enabled": {
          "type": "boolean",
          "default": true
        },
        "email_enabled": {
          "type": "boolean",
          "default": true
        },
        "voice_calls_enabled": {
          "type": "boolean",
          "default": false
        },
        "ai_booking_agent_enabled": {
          "type": "boolean",
          "default": false
        },
        "lead_reactivation_enabled": {
          "type": "boolean",
          "default": false
        },
        "review_request_enabled": {
          "type": "boolean",
          "default": false
        },
        "nurture_sequence_enabled": {
          "type": "boolean",
          "default": false
        },
        "ai_intelligence_enabled": {
          "type": "boolean",
          "default": false
        },
        "advanced_analytics_enabled": {
          "type": "boolean",
          "default": false
        },
        "conversion_insights_enabled": {
          "type": "boolean",
          "default": false
        },
        "funnel_optimization_enabled": {
          "type": "boolean",
          "default": false
        },
        "command_center_enabled": {
          "type": "boolean",
          "default": false
        },
        "assisted_operations_enabled": {
          "type": "boolean",
          "default": false
        },
        "white_label_enabled": {
          "type": "boolean",
          "default": false
        },
        "api_access_enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "usage_limits": {
      "type": "object",
      "title": "Plan Usage Limits",
      "properties": {
        "max_leads_per_month": {
          "type": "integer",
          "default": 500
        },
        "max_sms_per_month": {
          "type": "integer",
          "default": 1000
        },
        "max_emails_per_month": {
          "type": "integer",
          "default": 2000
        },
        "max_automations": {
          "type": "integer",
          "default": 5
        },
        "max_clients": {
          "type": "integer",
          "default": 1
        }
      }
    },
    "usage_current_month": {
      "type": "object",
      "title": "Current Month Usage",
      "properties": {
        "leads_processed": {
          "type": "integer",
          "default": 0
        },
        "sms_sent": {
          "type": "integer",
          "default": 0
        },
        "emails_sent": {
          "type": "integer",
          "default": 0
        },
        "automations_triggered": {
          "type": "integer",
          "default": 0
        },
        "events_processed": {
          "type": "integer",
          "default": 0
        },
        "period_start": {
          "type": "string"
        }
      }
    },
    "usage_all_time": {
      "type": "object",
      "title": "All-Time Usage Totals",
      "description": "Cumulative usage across all time \u2014 informational only",
      "properties": {
        "leads_processed_count": {
          "type": "integer",
          "default": 0
        },
        "messages_sent_count": {
          "type": "integer",
          "default": 0
        },
        "automations_triggered_count": {
          "type": "integer",
          "default": 0
        },
        "event_volume_count": {
          "type": "integer",
          "default": 0
        },
        "emails_sent_count": {
          "type": "integer",
          "default": 0
        },
        "sms_sent_count": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "messaging_config": {
      "type": "object",
      "title": "Messaging Configuration",
      "properties": {
        "sms_template_instant": {
          "type": "string"
        },
        "sms_template_missed_call": {
          "type": "string"
        },
        "email_from_name": {
          "type": "string"
        },
        "email_reply_to": {
          "type": "string"
        },
        "booking_link": {
          "type": "string"
        },
        "review_link": {
          "type": "string"
        },
        "business_hours": {
          "type": "string"
        },
        "after_hours_behavior": {
          "type": "string",
          "enum": [
            "send_after_hours_sms",
            "hold_until_open"
          ],
          "default": "send_after_hours_sms"
        }
      }
    },
    "industry_config": {
      "type": "object",
      "title": "Industry Configuration",
      "properties": {
        "industry_slug": {
          "type": "string"
        },
        "service_type": {
          "type": "string"
        },
        "typical_job_value": {
          "type": "number"
        },
        "lead_response_goal_minutes": {
          "type": "integer",
          "default": 5
        }
      }
    },
    "automation_rules": {
      "type": "array",
      "title": "Client Automation Rules",
      "items": {
        "type": "object",
        "properties": {
          "rule_key": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "delay_minutes": {
            "type": "integer"
          },
          "channel": {
            "type": "string"
          }
        }
      }
    },
    "white_label": {
      "type": "object",
      "title": "White-Label Branding",
      "description": "Optional branding overrides for white-label support",
      "properties": {
        "brand_name_override": {
          "type": "string",
          "title": "Brand Name Override"
        },
        "logo_url_override": {
          "type": "string",
          "title": "Logo URL Override"
        },
        "primary_color": {
          "type": "string",
          "title": "Primary Color (hex)",
          "description": "e.g. #00AEEF"
        },
        "secondary_color": {
          "type": "string",
          "title": "Secondary Color (hex)"
        },
        "favicon_url": {
          "type": "string",
          "title": "Favicon URL"
        },
        "support_email_override": {
          "type": "string",
          "title": "Support Email Override"
        },
        "portal_domain": {
          "type": "string",
          "title": "Custom Portal Domain"
        }
      }
    },
    "workspace_status": {
      "type": "string",
      "title": "Workspace Status",
      "enum": [
        "onboarding",
        "setup",
        "active",
        "paused",
        "churned"
      ],
      "default": "onboarding"
    },
    "onboarding_completed_at": {
      "type": "string",
      "title": "Onboarding Completed At",
      "format": "date-time"
    },
    "activated_at": {
      "type": "string",
      "title": "Activated At",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "title": "Last Workspace Activity At",
      "format": "date-time"
    },
    "health_score": {
      "type": "number",
      "title": "Workspace Health Score (0-100)",
      "default": 0
    },
    "churn_risk": {
      "type": "string",
      "title": "Churn Risk",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "platform_role": {
      "type": "string",
      "title": "Platform Role",
      "enum": [
        "platform_admin",
        "client_admin",
        "viewer"
      ],
      "default": "client_admin",
      "description": "Controls access scope: platform_admin has global access, client_admin is scoped to own workspace"
    },
    "notes": {
      "type": "string",
      "title": "Platform Admin Notes"
    }
  },
  "required": [
    "client_id",
    "business_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}