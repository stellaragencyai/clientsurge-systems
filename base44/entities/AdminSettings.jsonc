{
  "name": "AdminSettings",
  "type": "object",
  "properties": {
    "twilio_enabled": {
      "type": "boolean",
      "title": "Twilio Enabled",
      "default": false
    },
    "twilio_from_number": {
      "type": "string",
      "title": "Twilio From Number"
    },
    "twilio_account_sid_present": {
      "type": "boolean",
      "title": "Twilio Account SID Present",
      "default": false
    },
    "twilio_auth_token_present": {
      "type": "boolean",
      "title": "Twilio Auth Token Present",
      "default": false
    },
    "resend_enabled": {
      "type": "boolean",
      "title": "Resend Email Enabled",
      "default": false
    },
    "resend_from_email": {
      "type": "string",
      "title": "Resend From Email"
    },
    "gmail_enabled": {
      "type": "boolean",
      "title": "Gmail Enabled",
      "default": false
    },
    "gmail_from_email": {
      "type": "string",
      "title": "Gmail From Email"
    },
    "lead_notification_email": {
      "type": "string",
      "title": "Admin Notification Email"
    },
    "booking_link_default": {
      "type": "string",
      "title": "Default Booking Link"
    },
    "webhook_enabled": {
      "type": "boolean",
      "title": "Webhooks Enabled",
      "default": false
    },
    "webhook_url": {
      "type": "string",
      "title": "Webhook URL"
    },
    "sms_template": {
      "type": "string",
      "title": "Lead Response SMS Template"
    },
    "email_confirmation_template": {
      "type": "string",
      "title": "Lead Response Email Template"
    },
    "missed_call_sms_template": {
      "type": "string",
      "title": "Missed Call SMS Template"
    },
    "follow_up_day1_sms": {
      "type": "string",
      "title": "Follow-Up Day 1 SMS"
    },
    "follow_up_day3_sms": {
      "type": "string",
      "title": "Follow-Up Day 3 SMS"
    },
    "follow_up_day7_sms": {
      "type": "string",
      "title": "Follow-Up Day 7 SMS"
    },
    "admin_notification_template": {
      "type": "string",
      "title": "Admin Notification Email Template"
    },
    "last_webhook_test_result": {
      "type": "string",
      "title": "Last Webhook Test Result"
    },
    "last_webhook_test_at": {
      "type": "string",
      "title": "Last Webhook Test At"
    },
    "cadence_default_mode": {
      "type": "string",
      "title": "Default Cadence Mode",
      "enum": [
        "auto",
        "sms_first",
        "email_first"
      ],
      "default": "auto"
    },
    "cadence_switch_attempts": {
      "type": "integer",
      "title": "Switch Channel After N Attempts",
      "default": 3,
      "description": "After 3 attempts with no response, switch to alternate channel"
    },
    "cadence_pause_on_reply": {
      "type": "boolean",
      "title": "Pause Sequence on Lead Reply",
      "default": true
    },
    "cadence_engagement_threshold": {
      "type": "number",
      "title": "Engagement Score Threshold (0-100)",
      "default": 50,
      "description": "Increase follow-up frequency if lead engagement > threshold"
    },
    "cadence_max_attempts": {
      "type": "integer",
      "title": "Max Follow-Up Attempts",
      "default": 6,
      "description": "Stop automation after N total attempts"
    },
    "voice_calls_enabled": {
      "type": "boolean",
      "title": "AI Voice Calls Enabled",
      "default": false,
      "description": "When true, HOT leads (score \u226575) receive an ElevenLabs outbound voice call within 5 minutes"
    },
    "elevenlabs_agent_ids": {
      "type": "object",
      "title": "ElevenLabs Agent IDs (per industry)",
      "description": "Maps industry_key \u2192 ElevenLabs agent_id. Set by createElevenLabsAgent admin function.",
      "properties": {
        "med_spa": {
          "type": "string"
        },
        "dental": {
          "type": "string"
        },
        "chiropractic": {
          "type": "string"
        },
        "hvac": {
          "type": "string"
        },
        "roofing": {
          "type": "string"
        },
        "contractors": {
          "type": "string"
        }
      }
    }
  },
  "required": []
}
