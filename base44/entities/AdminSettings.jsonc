{
  "name": "AdminSettings",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "twilio_enabled": {
      "type": "boolean",
      "title": "Twilio Enabled",
      "default": false
    },
    "twilio_from_number": {
      "type": "string",
      "title": "Twilio From Number"
    },
    "twilio_account_sid_present": {
      "type": "boolean",
      "title": "Twilio Account SID Present",
      "default": false
    },
    "twilio_auth_token_present": {
      "type": "boolean",
      "title": "Twilio Auth Token Present",
      "default": false
    },
    "whatsapp_enabled": {
      "type": "boolean",
      "title": "WhatsApp Enabled",
      "default": false
    },
    "whatsapp_from_number": {
      "type": "string",
      "title": "WhatsApp From Number (Twilio)",
      "description": "Format: whatsapp:+1XXXXXXXXXX"
    },
    "resend_enabled": {
      "type": "boolean",
      "title": "Resend Email Enabled",
      "default": false
    },
    "resend_from_email": {
      "type": "string",
      "title": "Resend From Email"
    },
    "gmail_enabled": {
      "type": "boolean",
      "title": "Gmail Enabled",
      "default": false
    },
    "gmail_from_email": {
      "type": "string",
      "title": "Gmail From Email"
    },
    "lead_notification_email": {
      "type": "string",
      "title": "Admin Notification Email"
    },
    "max_active_onboarding": {
      "type": "integer",
      "title": "Max Active Onboarding",
      "default": 0
    },
    "blocked_dates": {
      "type": "array",
      "title": "Blocked Booking Dates",
      "items": {
        "type": "string"
      }
    },
    "allowed_admin_ips": {
      "type": "array",
      "title": "Allowed Admin IPs",
      "items": {
        "type": "string"
      }
    },
    "booking_link_default": {
      "type": "string",
      "title": "Default Booking Link"
    },
    "webhook_enabled": {
      "type": "boolean",
      "title": "Webhooks Enabled",
      "default": false
    },
    "webhook_url": {
      "type": "string",
      "title": "Webhook URL"
    },
    "sms_template": {
      "type": "string",
      "title": "Lead Response SMS Template"
    },
    "email_confirmation_template": {
      "type": "string",
      "title": "Lead Response Email Template"
    },
    "missed_call_sms_template": {
      "type": "string",
      "title": "Missed Call SMS Template (Initial)"
    },
    "follow_up_day1_sms": {
      "type": "string",
      "title": "Follow-Up SMS #2 (2 min after initial) \u2014 Light Nudge"
    },
    "follow_up_day3_sms": {
      "type": "string",
      "title": "Follow-Up SMS #3 (1 hour) \u2014 Urgency Trigger"
    },
    "follow_up_day7_sms": {
      "type": "string",
      "title": "Follow-Up SMS #4 (24 hours) \u2014 Clean Exit"
    },
    "missed_call_followup_email_1": {
      "type": "string",
      "title": "Follow-Up Email #2 (10 min) \u2014 Reduce Friction"
    },
    "missed_call_followup_email_2": {
      "type": "string",
      "title": "Follow-Up Email #3 (24 hours) \u2014 Final CTA"
    },
    "follow_up_booking_prompt_sms": {
      "type": "string",
      "title": "Qualified \u2192 Booking Prompt SMS (24h)"
    },
    "follow_up_booking_prompt_email": {
      "type": "string",
      "title": "Qualified \u2192 Booking Prompt Email Body (24h)"
    },
    "admin_notification_template": {
      "type": "string",
      "title": "Admin Notification Email Template"
    },
    "nurture_step1_subject": {
      "type": "string",
      "title": "Nurture Step 1 Subject (Day 0 \u2014 Welcome)"
    },
    "nurture_step1_body": {
      "type": "string",
      "title": "Nurture Step 1 Body (Day 0 \u2014 Welcome)"
    },
    "nurture_step2_subject": {
      "type": "string",
      "title": "Nurture Step 2 Subject (Day 3 \u2014 Case Study)"
    },
    "nurture_step2_body": {
      "type": "string",
      "title": "Nurture Step 2 Body (Day 3 \u2014 Case Study)"
    },
    "nurture_step3_subject": {
      "type": "string",
      "title": "Nurture Step 3 Subject (Day 7 \u2014 Testimonial)"
    },
    "nurture_step3_body": {
      "type": "string",
      "title": "Nurture Step 3 Body (Day 7 \u2014 Testimonial)"
    },
    "nurture_step4_subject": {
      "type": "string",
      "title": "Nurture Step 4 Subject (Day 10 \u2014 Tip)"
    },
    "nurture_step4_body": {
      "type": "string",
      "title": "Nurture Step 4 Body (Day 10 \u2014 Tip)"
    },
    "nurture_step5_subject": {
      "type": "string",
      "title": "Nurture Step 5 Subject (Day 14 \u2014 Case Study 2)"
    },
    "nurture_step5_body": {
      "type": "string",
      "title": "Nurture Step 5 Body (Day 14 \u2014 Case Study 2)"
    },
    "nurture_step6_subject": {
      "type": "string",
      "title": "Nurture Step 6 Subject (Day 18 \u2014 Testimonial 2)"
    },
    "nurture_step6_body": {
      "type": "string",
      "title": "Nurture Step 6 Body (Day 18 \u2014 Testimonial 2)"
    },
    "nurture_step7_subject": {
      "type": "string",
      "title": "Nurture Step 7 Subject (Day 23 \u2014 Tip + Offer)"
    },
    "nurture_step7_body": {
      "type": "string",
      "title": "Nurture Step 7 Body (Day 23 \u2014 Tip + Offer)"
    },
    "nurture_step8_subject": {
      "type": "string",
      "title": "Nurture Step 8 Subject (Day 30 \u2014 Final CTA)"
    },
    "nurture_step8_body": {
      "type": "string",
      "title": "Nurture Step 8 Body (Day 30 \u2014 Final CTA)"
    },
    "last_webhook_test_result": {
      "type": "string",
      "title": "Last Webhook Test Result"
    },
    "last_webhook_test_at": {
      "type": "string",
      "title": "Last Webhook Test At"
    },
    "cadence_default_mode": {
      "type": "string",
      "title": "Default Cadence Mode",
      "enum": [
        "auto",
        "sms_first",
        "email_first"
      ],
      "default": "auto"
    },
    "cadence_switch_attempts": {
      "type": "integer",
      "title": "Switch Channel After N Attempts",
      "default": 3
    },
    "cadence_pause_on_reply": {
      "type": "boolean",
      "title": "Pause Sequence on Lead Reply",
      "default": true
    },
    "cadence_engagement_threshold": {
      "type": "number",
      "title": "Engagement Score Threshold (0-100)",
      "default": 50
    },
    "cadence_max_attempts": {
      "type": "integer",
      "title": "Max Follow-Up Attempts",
      "default": 6
    },
    "voice_calls_enabled": {
      "type": "boolean",
      "title": "AI Voice Calls Enabled (HOT Leads)",
      "default": false,
      "description": "When true, HOT leads (score \u226575) receive an ElevenLabs outbound voice call within 5 minutes"
    },
    "inbound_voice_enabled": {
      "type": "boolean",
      "title": "AI Inbound Call Handler Enabled",
      "default": false,
      "description": "When true, inbound calls to your Twilio number are answered by ElevenLabs AI receptionist"
    },
    "payment_recovery_voice_enabled": {
      "type": "boolean",
      "title": "Payment Recovery Voice Call Enabled",
      "default": false,
      "description": "When true, failed Stripe payments trigger an ElevenLabs outbound call to the client"
    },
    "voice_briefing_enabled": {
      "type": "boolean",
      "title": "Daily Voice Briefing Enabled (Nolan)",
      "default": false,
      "description": "When true, calls Nolan daily at 7am with AI-generated business briefing"
    },
    "voice_briefing_phone": {
      "type": "string",
      "title": "Voice Briefing Phone Number",
      "description": "Phone number to call for daily briefing (defaults to ADMIN_NOTIFICATION_PHONE secret)"
    },
    "elevenlabs_agent_ids": {
      "type": "object",
      "title": "ElevenLabs Agent IDs",
      "description": "Maps role_key \u2192 ElevenLabs agent_id. Get from ElevenLabs dashboard \u2192 Agents.",
      "properties": {
        "med_spa": {
          "type": "string",
          "title": "Med Spa Agent ID"
        },
        "dental": {
          "type": "string",
          "title": "Dental Agent ID"
        },
        "chiropractic": {
          "type": "string",
          "title": "Chiropractic Agent ID"
        },
        "hvac": {
          "type": "string",
          "title": "HVAC Agent ID"
        },
        "roofing": {
          "type": "string",
          "title": "Roofing Agent ID"
        },
        "contractors": {
          "type": "string",
          "title": "Contractors Agent ID"
        },
        "receptionist": {
          "type": "string",
          "title": "Inbound Receptionist Agent ID"
        },
        "payment_recovery": {
          "type": "string",
          "title": "Payment Recovery Agent ID"
        },
        "briefing": {
          "type": "string",
          "title": "Daily Briefing Agent ID"
        },
        "general": {
          "type": "string",
          "title": "General / Fallback Agent ID"
        }
      }
    },
    "elevenlabs_phone_number_ids": {
      "type": "object",
      "title": "ElevenLabs Phone Number IDs",
      "description": "Maps role_key \u2192 ElevenLabs phone_number_id. Get from ElevenLabs dashboard \u2192 Phone Numbers.",
      "properties": {
        "med_spa": {
          "type": "string",
          "title": "Med Spa Phone Number ID"
        },
        "dental": {
          "type": "string",
          "title": "Dental Phone Number ID"
        },
        "chiropractic": {
          "type": "string",
          "title": "Chiropractic Phone Number ID"
        },
        "hvac": {
          "type": "string",
          "title": "HVAC Phone Number ID"
        },
        "roofing": {
          "type": "string",
          "title": "Roofing Phone Number ID"
        },
        "contractors": {
          "type": "string",
          "title": "Contractors Phone Number ID"
        },
        "general": {
          "type": "string",
          "title": "General / Fallback Phone Number ID"
        }
      }
    }
  },
  "required": []
}
