{
  "name": "DeadLetterLog",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "entity_name": {
      "type": "string",
      "title": "Failed Entity Type",
      "description": "e.g. AutomationJob, CommunicationEvent, EventQueue"
    },
    "entity_id": {
      "type": "string",
      "title": "Failed Entity ID"
    },
    "final_attempt": {
      "type": "integer",
      "title": "Final Attempt Number",
      "description": "Number of retry attempts made before moving to dead letter"
    },
    "error_message": {
      "type": "string",
      "title": "Error Message",
      "maxLength": 2000
    },
    "error_stack": {
      "type": "string",
      "title": "Error Stack Trace",
      "maxLength": 5000
    },
    "context_json": {
      "type": "string",
      "title": "Additional Context (JSON)",
      "description": "Job metadata, event details, or other context"
    },
    "status": {
      "type": "string",
      "title": "Review Status",
      "enum": [
        "pending_review",
        "acknowledged",
        "investigating",
        "fixed",
        "archived"
      ],
      "default": "pending_review"
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Notes",
      "maxLength": 2000
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed By (Admin Email)"
    },
    "reviewed_at": {
      "type": "string",
      "title": "Reviewed At",
      "format": "date-time"
    },
    "moved_at": {
      "type": "string",
      "title": "Moved to Dead Letter At",
      "format": "date-time"
    }
  },
  "required": [
    "entity_name",
    "entity_id",
    "error_message",
    "final_attempt",
    "moved_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}