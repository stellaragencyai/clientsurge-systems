{
  "name": "CommunicationEvent",
  "type": "object",
  "_metadata": {
    "status": "CORE_PRODUCTION",
    "reason": "Primary event log - immutable append-only audit trail.",
    "immutable": true,
    "tenant_scoped": "client_id + client_project_id"
  },
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "tenant_scope_error": {
      "type": "string",
      "title": "Tenant Scope Error"
    },
    "onboarding_client_id": {
      "type": "string",
      "title": "Onboarding Client ID"
    },
    "service_key": {
      "type": "string",
      "title": "Service Key"
    },
    "context_type": {
      "type": "string",
      "title": "Context Type"
    },
    "context_id": {
      "type": "string",
      "title": "Context ID"
    },
    "channel": {
      "type": "string",
      "title": "Channel",
      "enum": [
        "sms",
        "email",
        "webhook",
        "internal",
        "voice"
      ]
    },
    "direction": {
      "type": "string",
      "title": "Direction",
      "enum": [
        "outbound",
        "inbound",
        "system"
      ]
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "lead_created",
        "sms_sent",
        "sms_failed",
        "sms_skipped",
        "sms_blocked",
        "sms_received",
        "sms_delivered",
        "sms_link_clicked",
        "sms_link_previewed",
        "email_sent",
        "email_failed",
        "email_skipped",
        "email_blocked",
        "outbound_hold",
        "webhook_sent",
        "order_paid",
        "install_initialized",
        "service_configuration_updated",
        "service_status_changed",
        "service_transition_blocked",
        "runtime_attempt_started",
        "runtime_attempt_blocked",
        "provider_send_attempted",
        "provider_send_succeeded",
        "provider_send_failed",
        "booking_simulation_created",
        "booking_created",
        "lead_reactivation_batch_completed",
        "portal_login",
        "review_request_trigger_simulated",
        "workflow_triggered",
        "status_update",
        "ai_generated",
        "voice_call_initiated",
        "voice_call_answered",
        "voice_call_no_answer",
        "voice_call_completed",
        "tenant_scope_blocked"
      ]
    },
    "provider": {
      "type": "string",
      "title": "Provider",
      "enum": [
        "twilio",
        "resend",
        "stripe",
        "gmail",
        "zapier",
        "n8n",
        "internal",
        "internal_guardrail",
        "internal_compliance_guard",
        "elevenlabs"
      ]
    },
    "provider_from_number": {
      "type": "string",
      "title": "Provider From Number (SMS/Voice)"
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "opened",
        "clicked",
        "received",
        "processed",
        "skipped",
        "blocked"
      ]
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "message_body": {
      "type": "string",
      "title": "Message Body"
    },
    "provider_message_id": {
      "type": "string",
      "title": "Provider Message ID"
    },
    "error_message": {
      "type": "string",
      "title": "Error Message"
    },
    "metadata_json": {
      "type": "string",
      "title": "Metadata"
    },
    "environment": {
      "type": "string",
      "title": "Environment",
      "enum": [
        "production",
        "qa",
        "smoke",
        "demo",
        "internal",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_excluded": {
      "type": "boolean",
      "title": "Excluded From Dashboard",
      "default": false
    },
    "dashboard_exclusion_reason": {
      "type": "string",
      "title": "Dashboard Exclusion Reason"
    },
    "dashboard_truth_status": {
      "type": "string",
      "title": "Dashboard Truth Status",
      "enum": [
        "trusted",
        "warning",
        "blocked",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_truth_notes": {
      "type": "string",
      "title": "Dashboard Truth Notes"
    }
  },
  "required": [
    "channel",
    "direction",
    "event_type",
    "provider",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        },
        {
          "data.order_id": {
            "$in": [
              "{{orders.id}}"
            ]
          }
        },
        {
          "data.lead_id": {
            "$in": [
              "{{leads.id}}"
            ]
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
