{
  "name": "CommunicationEvent",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "onboarding_client_id": {
      "type": "string",
      "title": "Onboarding Client ID"
    },
    "service_key": {
      "type": "string",
      "title": "Service Key"
    },
    "context_type": {
      "type": "string",
      "title": "Context Type"
    },
    "context_id": {
      "type": "string",
      "title": "Context ID"
    },
    "channel": {
      "type": "string",
      "title": "Channel",
      "enum": [
        "sms",
        "email",
        "webhook",
        "internal",
        "voice"
      ]
    },
    "direction": {
      "type": "string",
      "title": "Direction",
      "enum": [
        "outbound",
        "inbound",
        "system"
      ]
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "lead_created",
        "sms_sent",
        "sms_failed",
        "sms_received",
        "sms_delivered",
        "email_sent",
        "email_failed",
        "webhook_sent",
        "order_paid",
        "install_initialized",
        "service_configuration_updated",
        "service_status_changed",
        "service_transition_blocked",
        "runtime_attempt_started",
        "runtime_attempt_blocked",
        "provider_send_attempted",
        "provider_send_succeeded",
        "provider_send_failed",
        "booking_simulation_created",
        "booking_created",
        "lead_reactivation_batch_completed",
        "review_request_trigger_simulated",
        "workflow_triggered",
        "status_update",
        "ai_generated",
        "voice_call_initiated",
        "voice_call_answered",
        "voice_call_no_answer",
        "voice_call_completed"
      ]
    },
    "provider": {
      "type": "string",
      "title": "Provider",
      "enum": [
        "twilio",
        "resend",
        "stripe",
        "gmail",
        "zapier",
        "n8n",
        "internal",
        "elevenlabs"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "opened",
        "received",
        "processed"
      ]
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "message_body": {
      "type": "string",
      "title": "Message Body"
    },
    "provider_message_id": {
      "type": "string",
      "title": "Provider Message ID"
    },
    "error_message": {
      "type": "string",
      "title": "Error Message"
    },
    "metadata_json": {
      "type": "string",
      "title": "Metadata"
    }
  },
  "required": [
    "channel",
    "direction",
    "event_type",
    "provider",
    "status"
