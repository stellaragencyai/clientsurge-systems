{
  "name": "TwilioGrowthOperatorNote",
  "type": "object",
  "title": "Twilio Growth Engine Operator Note",
  "description": "Admin-only manual observation notes attached to a capability row. Notes never override computed status or make a capability trusted.",
  "properties": {
    "capability_key": {
      "type": "string",
      "title": "Capability Key",
      "description": "The capability key this note is attached to (e.g. instant_lead_response, missed_call_text_back)"
    },
    "note_text": {
      "type": "string",
      "title": "Note Text",
      "maxLength": 2000
    },
    "author_email": {
      "type": "string",
      "title": "Author Email"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    }
  },
  "required": [
    "capability_key",
    "note_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}