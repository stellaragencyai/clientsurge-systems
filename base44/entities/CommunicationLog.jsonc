{
  "name": "CommunicationLog",
  "type": "object",
  "title": "Communication Log",
  "description": "Durable provider log for every Twilio SMS and Resend email send attempt.",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "related_entity_type": {
      "type": "string",
      "title": "Related Entity Type"
    },
    "related_entity_id": {
      "type": "string",
      "title": "Related Entity ID"
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "tenant_scope_error": {
      "type": "string",
      "title": "Tenant Scope Error",
      "description": "e.g. missing_client_id_tenant_scope when send was blocked"
    },
    "lead_email": {
      "type": "string",
      "title": "Lead Email"
    },
    "lead_phone": {
      "type": "string",
      "title": "Lead Phone"
    },
    "canonical_to_address": {
      "type": "string",
      "title": "Canonical To Address (E.164)"
    },
    "lead_name": {
      "type": "string",
      "title": "Lead Name"
    },
    "channel": {
      "type": "string",
      "title": "Channel",
      "enum": [
        "sms",
        "email",
        "voice",
        "system"
      ],
      "default": "sms"
    },
    "provider": {
      "type": "string",
      "title": "Provider",
      "enum": [
        "twilio",
        "resend",
        "base44",
        "internal"
      ],
      "default": "twilio"
    },
    "direction": {
      "type": "string",
      "title": "Direction",
      "enum": [
        "outbound",
        "inbound"
      ],
      "default": "outbound"
    },
    "trigger_name": {
      "type": "string",
      "title": "Trigger Name"
    },
    "template_name": {
      "type": "string",
      "title": "Template Name"
    },
    "to_address": {
      "type": "string",
      "title": "To Address"
    },
    "from_address": {
      "type": "string",
      "title": "From Address"
    },
    "provider_from_number": {
      "type": "string",
      "title": "Provider From Number (SMS)",
      "description": "Twilio from number used for this send."
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email",
      "description": "Resend from email used for this send."
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "body_preview": {
      "type": "string",
      "title": "Body Preview",
      "maxLength": 500
    },
    "provider_message_id": {
      "type": "string",
      "title": "Provider Message ID"
    },
    "provider_status": {
      "type": "string",
      "title": "Provider Status"
    },
    "delivery_status": {
      "type": "string",
      "title": "Delivery Status",
      "enum": [
        "queued",
        "sent",
        "delivered",
        "failed",
        "skipped",
        "unknown"
      ],
      "default": "unknown"
    },
    "error_code": {
      "type": "string",
      "title": "Error Code"
    },
    "error_message": {
      "type": "string",
      "title": "Error Message"
    },
    "request_payload_redacted": {
      "type": "string",
      "title": "Request Payload (Redacted)"
    },
    "response_payload_redacted": {
      "type": "string",
      "title": "Response Payload (Redacted)"
    },
    "sent_at": {
      "type": "string",
      "title": "Sent At",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "title": "Delivered At",
      "format": "date-time"
    },
    "failed_at": {
      "type": "string",
      "title": "Failed At",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "title": "Environment",
      "enum": [
        "production",
        "preview",
        "test"
      ],
      "default": "production"
    },
    "superseded_note": {
      "type": "string",
      "title": "Superseded Note"
    }
  },
  "required": [
    "channel",
    "provider",
    "direction",
    "trigger_name",
    "delivery_status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}