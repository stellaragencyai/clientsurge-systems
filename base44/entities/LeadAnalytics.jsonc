{
  "name": "LeadAnalytics",
  "type": "object",
  "_metadata": {
    "status": "DERIVED",
    "reason": "Calculated metrics for reporting only. Do NOT write directly. Derived from Leads + CommunicationEvent. Use scheduled jobs only.",
    "read_only": true,
    "documentation": "ARCHITECTURE_CONSOLIDATION.md"
  },
  "properties": {
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "snapshot_date": {
      "type": "string",
      "title": "Snapshot Date",
      "format": "date-time"
    },
    "leads_captured_total": {
      "type": "number",
      "title": "Total Leads Captured",
      "default": 0
    },
    "leads_captured_this_period": {
      "type": "number",
      "title": "Leads Captured This Period (24h)",
      "default": 0
    },
    "leads_responded": {
      "type": "number",
      "title": "Leads Responded",
      "default": 0
    },
    "automations_active": {
      "type": "number",
      "title": "Active Automations",
      "default": 0
    },
    "automations_triggered_today": {
      "type": "number",
      "title": "Automations Triggered Today",
      "default": 0
    },
    "sms_sent_count": {
      "type": "number",
      "title": "SMS Messages Sent",
      "default": 0
    },
    "emails_sent_count": {
      "type": "number",
      "title": "Emails Sent",
      "default": 0
    },
    "bookings_created_total": {
      "type": "number",
      "title": "Total Bookings Created",
      "default": 0
    },
    "bookings_created_today": {
      "type": "number",
      "title": "Bookings Created Today",
      "default": 0
    }
  }
}