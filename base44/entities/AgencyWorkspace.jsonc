{
  "name": "AgencyWorkspace",
  "type": "object",
  "_metadata": {
    "status": "SAAS_AGENCY_LAYER",
    "reason": "Represents a single agency customer managing multiple client accounts within ClientSurge.",
    "tenant_scoped": "agency_id"
  },
  "properties": {
    "agency_id": {
      "type": "string",
      "title": "Agency ID",
      "description": "Unique identifier for this agency workspace"
    },
    "agency_name": {
      "type": "string",
      "title": "Agency Name",
      "description": "Human-readable name of the agency (e.g., 'Digital Growth Agency')"
    },
    "owner_email": {
      "type": "string",
      "title": "Agency Owner Email",
      "description": "Primary contact email for the agency account"
    },
    "owner_name": {
      "type": "string",
      "title": "Agency Owner Name",
      "description": "Full name of the agency owner"
    },
    "industry_focus": {
      "type": "array",
      "title": "Industry Focus",
      "items": {
        "type": "string"
      },
      "description": "Industries the agency specializes in (roofing, hvac, dental, etc.)",
      "default": []
    },
    "plan_type": {
      "type": "string",
      "title": "Plan Type",
      "enum": [
        "starter",
        "growth",
        "enterprise"
      ],
      "default": "starter",
      "description": "Subscription tier for this agency"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "onboarding",
        "active",
        "paused",
        "suspended"
      ],
      "default": "onboarding",
      "description": "Current status of the agency workspace"
    },
    "total_clients": {
      "type": "integer",
      "title": "Total Clients",
      "default": 0,
      "description": "Count of client accounts managed by this agency"
    },
    "active_clients": {
      "type": "integer",
      "title": "Active Clients",
      "default": 0,
      "description": "Count of currently active client accounts"
    },
    "clients_limit": {
      "type": "integer",
      "title": "Clients Limit",
      "default": 1,
      "description": "Maximum number of clients allowed for this plan (1 for starter, 10 for growth, unlimited for enterprise)"
    },
    "revenue_mtd": {
      "type": "number",
      "title": "Revenue MTD ($)",
      "default": 0,
      "description": "Total revenue generated by this agency this month"
    },
    "revenue_all_time": {
      "type": "number",
      "title": "Revenue All Time ($)",
      "default": 0,
      "description": "Total cumulative revenue from all clients"
    },
    "stripe_customer_id": {
      "type": "string",
      "title": "Stripe Customer ID",
      "description": "Stripe customer ID for billing this agency"
    },
    "stripe_subscription_id": {
      "type": "string",
      "title": "Stripe Subscription ID",
      "description": "Stripe subscription ID for ongoing charges"
    },
    "billing_email": {
      "type": "string",
      "title": "Billing Email",
      "description": "Email for billing communications"
    },
    "white_label_enabled": {
      "type": "boolean",
      "title": "White Label Enabled",
      "default": false,
      "description": "Whether this agency can use white-label branding"
    },
    "api_key": {
      "type": "string",
      "title": "API Key",
      "description": "Secret API key for agency integrations (if applicable)"
    },
    "created_at": {
      "type": "string",
      "title": "Created At",
      "format": "date-time",
      "description": "When this agency workspace was created"
    },
    "activated_at": {
      "type": "string",
      "title": "Activated At",
      "format": "date-time",
      "description": "When this agency was activated (moved from onboarding to active)"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "description": "Internal notes on the agency account"
    }
  },
  "required": [
    "agency_id",
    "agency_name",
    "owner_email",
    "plan_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}