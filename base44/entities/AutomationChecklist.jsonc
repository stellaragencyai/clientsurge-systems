{
  "name": "AutomationChecklist",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "client_name": {
      "type": "string",
      "title": "Client Name"
    },
    "client_email": {
      "type": "string",
      "title": "Client Email"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID (Tenant Isolation)"
    },
    "client_project_id": {
      "type": "string",
      "title": "Client Project ID (Tenant Isolation)"
    },
    "tenant_scope_status": {
      "type": "string",
      "title": "Tenant Scope Status",
      "enum": [
        "scoped",
        "missing_client_id",
        "needs_backfill",
        "manual_review",
        "system_internal"
      ],
      "default": "missing_client_id"
    },
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "service_key": {
      "type": "string",
      "title": "Service Key",
      "enum": [
        "instant_lead_response",
        "missed_call_text_back",
        "nurture_sequence_14d",
        "ai_booking_agent",
        "daily_lead_digest",
        "inbound_sms_assistant",
        "ai_voice_receptionist",
        "lead_reactivation",
        "review_request"
      ]
    },
    "status": {
      "type": "string",
      "title": "Automation Status",
      "enum": [
        "not_started",
        "in_progress",
        "active",
        "failed",
        "paused"
      ],
      "default": "not_started"
    },
    "installed_by": {
      "type": "string",
      "title": "Installed By (Admin Email)"
    },
    "last_tested_at": {
      "type": "string",
      "title": "Last Tested At",
      "format": "date-time"
    },
    "went_live_at": {
      "type": "string",
      "title": "Went Live At",
      "format": "date-time"
    },
    "failure_notes": {
      "type": "string",
      "title": "Failure Notes"
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Notes"
    },
    "steps_completed": {
      "type": "array",
      "title": "Completed Step IDs",
      "items": {
        "type": "string"
      }
    },
    "twilio_configured": {
      "type": "boolean",
      "title": "Twilio Configured",
      "default": false
    },
    "resend_configured": {
      "type": "boolean",
      "title": "Resend Configured",
      "default": false
    },
    "booking_link_set": {
      "type": "boolean",
      "title": "Booking Link Set",
      "default": false
    },
    "review_link_set": {
      "type": "boolean",
      "title": "Review Link Set",
      "default": false
    },
    "lead_form_connected": {
      "type": "boolean",
      "title": "Lead Form Connected",
      "default": false
    },
    "communication_event_logging_verified": {
      "type": "boolean",
      "title": "CommunicationEvent Logging Verified",
      "default": false
    },
    "test_lead_sent": {
      "type": "boolean",
      "title": "Test Lead Sent",
      "default": false
    },
    "test_response_received": {
      "type": "boolean",
      "title": "Test Response Received",
      "default": false
    },
    "client_approved": {
      "type": "boolean",
      "title": "Client Sign-Off Received",
      "default": false
    },
    "provider_from_number": {
      "type": "string",
      "title": "Provider From Number (SMS)"
    },
    "provider_from_email": {
      "type": "string",
      "title": "Provider From Email"
    },
    "environment": {
      "type": "string",
      "title": "Environment",
      "enum": [
        "production",
        "qa",
        "smoke",
        "demo",
        "internal",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_excluded": {
      "type": "boolean",
      "title": "Excluded From Dashboard",
      "default": false
    },
    "dashboard_exclusion_reason": {
      "type": "string",
      "title": "Dashboard Exclusion Reason"
    },
    "dashboard_truth_status": {
      "type": "string",
      "title": "Dashboard Truth Status",
      "enum": [
        "trusted",
        "warning",
        "blocked",
        "unknown"
      ],
      "default": "unknown"
    },
    "dashboard_truth_notes": {
      "type": "string",
      "title": "Dashboard Truth Notes"
    }
  },
  "required": [
    "client_email",
    "service_key",
    "business_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.client_id": "{{client_id}}"
        },
        {
          "data.client_project_id": "{{client_project_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
