<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,follow" />
  <title>Complete Your ClientSurge Package | ClientSurge Systems</title>
  <meta name="description" content="Choose a ClientSurge Systems package and continue to the safe checkout flow." />
  <style>
    :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: linear-gradient(135deg, #f7fbff 0%, #ffffff 55%, #edf8ff 100%); color: #0a1628; }
    main { width: min(720px, calc(100vw - 32px)); padding: 40px; border: 1px solid rgba(0, 136, 204, 0.18); border-radius: 24px; background: rgba(255,255,255,.88); box-shadow: 0 24px 80px rgba(0, 59, 143, .12); }
    .eyebrow { margin: 0 0 12px; color: #0088cc; font-size: 12px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
    h1 { margin: 0 0 14px; font-size: clamp(32px, 5vw, 52px); line-height: 1.02; letter-spacing: -0.04em; color: #001b44; }
    p { margin: 0 0 24px; color: rgba(10, 22, 40, .68); font-size: 16px; line-height: 1.6; }
    .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 26px 0 18px; }
    a { text-decoration: none; }
    .btn { display: flex; align-items: center; justify-content: center; min-height: 52px; border-radius: 999px; font-weight: 900; color: #fff; background: linear-gradient(135deg, #00aeef 0%, #0088cc 45%, #003b8f 100%); box-shadow: 0 12px 28px rgba(0, 136, 204, .22); }
    .secondary { display: inline-flex; align-items: center; justify-content: center; color: #005f99; font-weight: 800; text-decoration: underline; text-underline-offset: 4px; }
    .note { margin-top: 20px; font-size: 13px; color: rgba(10, 22, 40, .52); }
    @media (max-width: 680px) { main { padding: 28px 20px; } .grid { grid-template-columns: 1fr; } }
  </style>
  <script>
    (function () {
      var aliases = {
        starter: "starter_system",
        starter_system: "starter_system",
        growth: "growth_system",
        growth_system: "growth_system",
        pro: "pro_system",
        pro_system: "pro_system",
        elite: "pro_system",
        elite_system: "pro_system"
      };
      var params = new URLSearchParams(window.location.search);
      var raw = (params.get("package") || params.get("plan") || "").toLowerCase().replace(/[\s-]+/g, "_");
      if (aliases[raw]) window.location.replace('/store?package=' + encodeURIComponent(aliases[raw]));
    })();
  </script>
</head>
<body>
  <main>
    <p class="eyebrow">Safe package checkout</p>
    <h1>Complete your ClientSurge signup.</h1>
    <p>Choose the package below and continue through the app checkout flow. This avoids direct live Stripe links during testing.</p>
    <div class="grid" aria-label="Choose package">
      <a class="btn" href="/store?package=starter_system">Starter</a>
      <a class="btn" href="/store?package=growth_system">Growth</a>
      <a class="btn" href="/store?package=pro_system">Pro</a>
    </div>
    <a class="secondary" href="/pricing">Back to package comparison</a>
    <p class="note">Use Stripe test card details only while test mode is active. Do not use a real card until live mode is intentionally restored.</p>
  </main>
</body>
</html>
