<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Complete Your ClientSurge Signup | ClientSurge Systems</title>
  <meta name="description" content="Choose Starter, Growth, or Pro and continue to secure checkout for your ClientSurge AI automation system." />
  <style>
    :root {
      color-scheme: light;
      --blue: #00aeef;
      --blue-dark: #003b8f;
      --ink: #001b44;
      --muted: #5d6b82;
      --border: rgba(0, 136, 204, .18);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: linear-gradient(180deg, #f5fbff 0%, #ffffff 45%, #f7fbff 100%); color: var(--ink); }
    .shell { min-height: 100vh; display: flex; flex-direction: column; }
    header { border-bottom: 1px solid var(--border); background: rgba(255,255,255,.88); backdrop-filter: blur(14px); }
    .top { width: min(1180px, calc(100vw - 32px)); margin: 0 auto; min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .brand { font-weight: 950; letter-spacing: -.04em; color: var(--ink); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
    .bolt { color: var(--blue); font-size: 26px; line-height: 1; }
    .top a:not(.brand) { color: var(--blue-dark); font-weight: 800; font-size: 13px; text-decoration: none; }
    main { flex: 1; width: min(1180px, calc(100vw - 32px)); margin: 0 auto; padding: 48px 0 72px; }
    .hero { margin-bottom: 28px; }
    .eyebrow { margin: 0 0 10px; color: var(--blue); font-size: 12px; font-weight: 950; letter-spacing: .18em; text-transform: uppercase; }
    h1 { margin: 0; max-width: 760px; font-size: clamp(34px, 5vw, 62px); line-height: .98; letter-spacing: -.055em; color: var(--ink); }
    .sub { max-width: 720px; margin: 18px 0 0; color: var(--muted); font-size: 17px; line-height: 1.65; }
    .grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: 28px; align-items: start; }
    .card { border: 1px solid var(--border); border-radius: 24px; background: rgba(255,255,255,.92); box-shadow: 0 24px 80px rgba(0, 59, 143, .10); padding: 26px; }
    .label { margin: 0 0 16px; font-size: 12px; font-weight: 950; color: #45546a; letter-spacing: .12em; text-transform: uppercase; }
    .plans { display: grid; gap: 14px; }
    .plan { width: 100%; text-align: left; border: 2px solid #e4edf5; border-radius: 18px; background: #fff; padding: 18px; cursor: pointer; transition: .18s ease; }
    .plan[aria-pressed="true"] { border-color: var(--blue); background: #f0f9ff; box-shadow: 0 12px 30px rgba(0, 174, 239, .14); }
    .badge { display: inline-flex; margin-bottom: 8px; padding: 5px 10px; border-radius: 999px; background: rgba(0,174,239,.12); color: #0088cc; font-size: 11px; font-weight: 900; }
    .plan-title { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
    .plan h2 { margin: 0; font-size: 20px; color: var(--ink); }
    .plan p { margin: 5px 0 0; color: var(--muted); font-size: 14px; line-height: 1.45; }
    .price { margin-top: 14px; color: var(--ink); font-size: 28px; font-weight: 950; letter-spacing: -.04em; }
    .price small { color: #7b8798; font-size: 14px; font-weight: 800; letter-spacing: 0; }
    .setup { margin-top: 4px; color: #7b8798; font-size: 12px; font-weight: 700; }
    .secure { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--border); background: rgba(0,174,239,.06); color: #0088cc; font-size: 12px; font-weight: 850; }
    .included { border-radius: 18px; border: 1px solid rgba(0,136,204,.12); background: #f8fcff; padding: 18px; margin-bottom: 20px; }
    .included h3 { margin: 0 0 12px; font-size: 17px; color: var(--ink); }
    .included ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
    .included li { color: #41506a; font-size: 14px; line-height: 1.4; }
    .included li::before { content: "✓"; color: var(--blue); font-weight: 950; margin-right: 8px; }
    form { display: grid; gap: 15px; }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    label { display: grid; gap: 7px; color: #41506a; font-size: 13px; font-weight: 850; }
    input { width: 100%; border: 1.5px solid #d8e6f1; border-radius: 14px; padding: 13px 14px; font: inherit; color: #0a1628; outline: none; background: #fff; }
    input:focus { border-color: rgba(0,174,239,.72); box-shadow: 0 0 0 4px rgba(0,174,239,.12); }
    .required { color: #e11d48; }
    .submit { min-height: 54px; border: 0; border-radius: 999px; font: inherit; font-weight: 950; color: #fff; background: linear-gradient(135deg, #00aeef 0%, #0088cc 45%, #003b8f 100%); cursor: pointer; box-shadow: 0 14px 30px rgba(0, 136, 204, .24); display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
    .submit:disabled { cursor: not-allowed; opacity: .65; }
    .error { display: none; margin-top: 16px; padding: 13px 14px; border-radius: 14px; background: #fff1f2; border: 1px solid #fecdd3; color: #be123c; font-size: 14px; font-weight: 750; line-height: 1.45; }
    .links { margin-top: 18px; display: flex; flex-wrap: wrap; justify-content: center; gap: 18px; font-size: 13px; }
    .links a { color: #006bb0; font-weight: 850; text-decoration: none; }
    .note { margin: 16px 0 0; text-align: center; color: #7b8798; font-size: 12px; line-height: 1.45; }
    @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } h1 { font-size: clamp(34px, 10vw, 50px); } }
    @media (max-width: 620px) { main { padding-top: 28px; } .card { padding: 20px; border-radius: 20px; } .row { grid-template-columns: 1fr; } .top { min-height: 64px; } }
  </style>
</head>
<body>
  <div class="shell">
    <header>
      <div class="top">
        <a class="brand" href="/"><span class="bolt">⚡</span>ClientSurge Systems</a>
        <a href="/pricing">Compare Packages</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Secure System Checkout</p>
        <h1>Complete your ClientSurge signup.</h1>
        <p class="sub">Choose Starter, Growth, or Pro. Enter your business details and continue to a secure checkout session. This fallback page exists so the signup route loads even if the app shell has a routing delay.</p>
      </section>

      <section class="grid">
        <aside class="card">
          <p class="label">Select a system</p>
          <div class="plans" id="plans"></div>
          <div class="secure">🔒 Secure Stripe checkout</div>
        </aside>

        <section class="card">
          <div class="included">
            <h3 id="included-title">What's included</h3>
            <ul id="included-list"></ul>
          </div>

          <form id="checkout-form">
            <p class="label">Your information</p>
            <div class="row">
              <label>Full Name <span class="required">*</span><input name="name" autocomplete="name" required placeholder="John Doe" /></label>
              <label>Business Name <span class="required">*</span><input name="business" autocomplete="organization" required placeholder="Your Business" /></label>
            </div>
            <div class="row">
              <label>Email <span class="required">*</span><input name="email" type="email" autocomplete="email" required placeholder="owner@yourbusiness.com" /></label>
              <label>Phone <span class="required">*</span><input name="phone" type="tel" autocomplete="tel" required placeholder="(602) 555-0100" /></label>
            </div>
            <label>Industry<input name="industry" autocomplete="organization-title" placeholder="e.g., HVAC, Dental, Roofing" /></label>
            <button class="submit" type="submit">Continue to Secure Checkout →</button>
          </form>
          <div id="error" class="error" role="alert"></div>
          <div class="links"><a href="/book">Need help choosing?</a><a href="/pricing">Back to packages</a></div>
          <p class="note">Checkout is created through the ClientSurge Base44 app function and Stripe.</p>
        </section>
      </section>
    </main>
  </div>

  <script>
    (function () {
      var appId = '69dc4a79656fdba136d413d3';
      var plans = [
        { id: 'starter_system', title: 'Starter System', price: '$497', setup: '$797 one-time', desc: 'Response and missed-call recovery foundation.', features: ['Lead capture', 'Instant lead response', 'Missed-call text-back', 'CRM handoff where supported', 'Basic follow-up'] },
        { id: 'growth_system', title: 'Growth System', price: '$997', setup: '$1,297 one-time', desc: 'Response, follow-up, and booking system.', recommended: true, features: ['Everything in Starter', 'AI scheduling handoff', 'Multi-step SMS/email follow-up', 'Booking automation', 'Client dashboard'] },
        { id: 'pro_system', title: 'Pro System', price: '$1,997', setup: '$2,497 one-time', desc: 'Full lead recovery and automation layer.', features: ['Everything in Growth', 'Website design and build', 'Lead reactivation', 'Advanced reporting', 'Priority setup'] }
      ];
      var aliases = { starter: 'starter_system', starter_system: 'starter_system', 'starter-system': 'starter_system', growth: 'growth_system', growth_system: 'growth_system', 'growth-system': 'growth_system', pro: 'pro_system', pro_system: 'pro_system', 'pro-system': 'pro_system', elite: 'pro_system', elite_system: 'pro_system' };
      var params = new URLSearchParams(window.location.search);
      var raw = (params.get('package') || params.get('plan') || 'growth_system').toLowerCase().replace(/[\s_]+/g, '-');
      var selectedPackage = aliases[raw] || 'growth_system';
      var plansEl = document.getElementById('plans');
      var includedTitle = document.getElementById('included-title');
      var includedList = document.getElementById('included-list');
      var form = document.getElementById('checkout-form');
      var submit = form.querySelector('button[type="submit"]');
      var errorBox = document.getElementById('error');

      function selectedPlan() { return plans.find(function (p) { return p.id === selectedPackage; }) || plans[1]; }
      function setError(message) { errorBox.textContent = message || ''; errorBox.style.display = message ? 'block' : 'none'; }
      function renderPlans() {
        plansEl.innerHTML = plans.map(function (plan) {
          return '<button type="button" class="plan" data-package="' + plan.id + '" aria-pressed="' + (plan.id === selectedPackage ? 'true' : 'false') + '">' +
            (plan.recommended ? '<span class="badge">Recommended</span>' : '') +
            '<div class="plan-title"><div><h2>' + plan.title + '</h2><p>' + plan.desc + '</p></div>' + (plan.id === selectedPackage ? '<strong style="color:#00aeef">✓</strong>' : '') + '</div>' +
            '<div class="price">' + plan.price + '<small>/mo</small></div><div class="setup">' + plan.setup + '</div></button>';
        }).join('');
        plansEl.querySelectorAll('[data-package]').forEach(function (button) {
          button.addEventListener('click', function () { selectedPackage = button.dataset.package; setError(''); renderPlans(); renderIncluded(); });
        });
      }
      function renderIncluded() {
        var plan = selectedPlan();
        includedTitle.textContent = "What's included in " + plan.title;
        includedList.innerHTML = plan.features.map(function (feature) { return '<li>' + feature + '</li>'; }).join('');
        submit.textContent = 'Continue with ' + plan.title + ' →';
      }
      function validPhone(value) { return String(value || '').replace(/\D/g, '').length >= 10; }

      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        setError('');
        var data = new FormData(form);
        var payload = {
          package_key: selectedPackage,
          customer_name: String(data.get('name') || '').trim(),
          customer_email: String(data.get('email') || '').trim(),
          customer_phone: String(data.get('phone') || '').trim(),
          business_name: String(data.get('business') || '').trim(),
          industry: String(data.get('industry') || '').trim(),
          success_url: window.location.origin + '/order-success?session_id={CHECKOUT_SESSION_ID}',
          cancel_url: window.location.origin + '/product-signup?package=' + encodeURIComponent(selectedPackage)
        };
        if (!payload.customer_name || !payload.business_name || !payload.customer_email || !validPhone(payload.customer_phone)) {
          setError('Please complete full name, business name, email, and a valid phone number.');
          return;
        }
        submit.disabled = true;
        submit.textContent = 'Creating checkout session...';
        try {
          var response = await fetch('/api/apps/' + appId + '/functions/createCheckoutSession', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          var result = await response.json().catch(function () { return {}; });
          var url = result.url || (result.data && result.data.url);
          if (!response.ok || !url) throw new Error(result.error || (result.data && result.data.error) || 'Checkout session could not be created.');
          window.location.href = url;
        } catch (error) {
          setError((error && error.message) || 'Checkout failed. Please try again or contact support.');
          submit.disabled = false;
          renderIncluded();
        }
      });

      renderPlans();
      renderIncluded();
    })();
  </script>
</body>
</html>
