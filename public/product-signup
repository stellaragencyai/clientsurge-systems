<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,follow" />
  <title>Complete Your ClientSurge Package | ClientSurge Systems</title>
  <meta name="description" content="Choose a ClientSurge Systems package and continue to the app checkout flow." />
  <style>
    :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: linear-gradient(135deg, #f7fbff 0%, #ffffff 55%, #edf8ff 100%); color: #0a1628; }
    main { width: min(760px, calc(100vw - 32px)); padding: 40px; border: 1px solid rgba(0, 136, 204, 0.18); border-radius: 24px; background: rgba(255,255,255,.9); box-shadow: 0 24px 80px rgba(0, 59, 143, .12); }
    .eyebrow { margin: 0 0 12px; color: #0088cc; font-size: 12px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
    h1 { margin: 0 0 14px; font-size: clamp(32px, 5vw, 52px); line-height: 1.02; letter-spacing: -0.04em; color: #001b44; }
    p { margin: 0 0 22px; color: rgba(10, 22, 40, .68); font-size: 16px; line-height: 1.6; }
    .package-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 24px 0; }
    .package-option { min-height: 48px; border: 1.5px solid rgba(0, 136, 204, .24); border-radius: 999px; background: #fff; color: #005f99; font-weight: 900; cursor: pointer; }
    .package-option[aria-pressed="true"] { color: #fff; background: linear-gradient(135deg, #00aeef 0%, #0088cc 45%, #003b8f 100%); box-shadow: 0 12px 28px rgba(0, 136, 204, .22); }
    form { display: grid; gap: 12px; }
    label { display: grid; gap: 6px; font-size: 12px; font-weight: 800; color: rgba(10, 22, 40, .68); text-transform: uppercase; letter-spacing: .08em; }
    input { width: 100%; border: 1.5px solid rgba(0, 136, 204, .20); border-radius: 14px; padding: 13px 14px; font: inherit; color: #0a1628; outline: none; background: #fff; }
    input:focus { border-color: rgba(0, 174, 239, .72); box-shadow: 0 0 0 4px rgba(0, 174, 239, .12); }
    .submit { margin-top: 8px; min-height: 54px; border: 0; border-radius: 999px; font: inherit; font-weight: 900; color: #fff; background: linear-gradient(135deg, #00aeef 0%, #0088cc 45%, #003b8f 100%); cursor: pointer; box-shadow: 0 12px 28px rgba(0, 136, 204, .22); }
    .submit:disabled { cursor: not-allowed; opacity: .65; }
    .secondary { display: inline-flex; margin-top: 18px; color: #005f99; font-weight: 800; text-decoration: underline; text-underline-offset: 4px; }
    .note { margin-top: 18px; font-size: 13px; color: rgba(10, 22, 40, .52); }
    .error { display: none; margin-top: 14px; padding: 12px 14px; border-radius: 14px; background: #fff1f2; border: 1px solid #fecdd3; color: #be123c; font-size: 14px; font-weight: 700; }
    @media (max-width: 680px) { main { padding: 28px 20px; } .package-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">Safe app checkout</p>
    <h1>Complete your ClientSurge signup.</h1>
    <p>Choose a package, enter your details, and continue through the app checkout session. This route does not use direct live Payment Links.</p>

    <div class="package-grid" aria-label="Choose package">
      <button class="package-option" type="button" data-package="starter_system">Starter</button>
      <button class="package-option" type="button" data-package="growth_system">Growth</button>
      <button class="package-option" type="button" data-package="pro_system">Pro</button>
    </div>

    <form id="checkout-form">
      <label>Full name<input name="name" autocomplete="name" required placeholder="Jane Smith" /></label>
      <label>Email<input name="email" type="email" autocomplete="email" required placeholder="jane@example.com" /></label>
      <label>Business name<input name="business" autocomplete="organization" required placeholder="Glow Med Spa" /></label>
      <label>Phone<input name="phone" autocomplete="tel" placeholder="+1 602 555 0123" /></label>
      <button class="submit" type="submit">Continue to secure checkout</button>
    </form>

    <div id="error" class="error" role="alert"></div>
    <a class="secondary" href="/pricing">Back to package comparison</a>
    <p class="note">The checkout mode is controlled by Base44 environment variables. Keep it in test mode until final production verification.</p>
  </main>

  <script>
    (function () {
      var appId = '69dc4a79656fdba136d413d3';
      var aliases = {
        starter: 'starter_system',
        starter_system: 'starter_system',
        growth: 'growth_system',
        growth_system: 'growth_system',
        pro: 'pro_system',
        pro_system: 'pro_system',
        elite: 'pro_system',
        elite_system: 'pro_system'
      };
      var packageNames = {
        starter_system: 'Starter',
        growth_system: 'Growth',
        pro_system: 'Pro'
      };
      var params = new URLSearchParams(window.location.search);
      var raw = (params.get('package') || params.get('plan') || 'growth_system').toLowerCase().replace(/[\s-]+/g, '_');
      var selectedPackage = aliases[raw] || 'growth_system';
      var errorBox = document.getElementById('error');
      var form = document.getElementById('checkout-form');
      var submit = form.querySelector('button[type="submit"]');

      function setError(message) {
        errorBox.textContent = message || '';
        errorBox.style.display = message ? 'block' : 'none';
      }

      function paintSelection() {
        document.querySelectorAll('[data-package]').forEach(function (button) {
          button.setAttribute('aria-pressed', button.dataset.package === selectedPackage ? 'true' : 'false');
        });
        submit.textContent = 'Continue with ' + packageNames[selectedPackage];
      }

      document.querySelectorAll('[data-package]').forEach(function (button) {
        button.addEventListener('click', function () {
          selectedPackage = button.dataset.package;
          setError('');
          paintSelection();
        });
      });

      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        setError('');
        submit.disabled = true;
        submit.textContent = 'Creating checkout session...';

        var data = new FormData(form);
        var payload = {
          package_key: selectedPackage,
          customer_name: String(data.get('name') || '').trim(),
          customer_email: String(data.get('email') || '').trim(),
          customer_phone: String(data.get('phone') || '').trim(),
          business_name: String(data.get('business') || '').trim(),
          success_url: window.location.origin + '/order-success?session_id={CHECKOUT_SESSION_ID}',
          cancel_url: window.location.origin + '/product-signup?package=' + encodeURIComponent(selectedPackage)
        };

        try {
          var response = await fetch('/api/apps/' + appId + '/functions/createCheckoutSession', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          var result = await response.json().catch(function () { return {}; });
          if (!response.ok || !result.url) {
            throw new Error(result.error || 'Checkout session could not be created.');
          }
          window.location.href = result.url;
        } catch (error) {
          setError(error.message || 'Checkout failed. Please try again or contact support.');
          submit.disabled = false;
          paintSelection();
        }
      });

      paintSelection();
    })();
  </script>
</body>
</html>
