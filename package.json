{
  "name": "base44-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:node && npm run test:deno",
    "test:node": "node --test",
    "test:deno": "deno test --allow-env --no-check base44/functions/__tests__/*.deno.ts",
    "release:base44": "pwsh -File scripts/release-base44.ps1",
    "base44:functions-check": "node scripts/base44/tolerant-functions-check.mjs",
    "stripe:bootstrap-local": "pwsh -File scripts/stripe/bootstrap-local-stripe.ps1",
    "stripe:ensure-test-catalog": "node scripts/stripe/ensure-test-package-catalog.mjs",
    "stripe:webhook-proof": "node scripts/stripe/stripe-webhook-proof.mjs",
    "openclaw:validate-install": "node scripts/openclaw/run-install-validation.mjs",
    "openclaw:basic-package-check": "node scripts/openclaw/basic-package-activation-check.mjs",
    "openclaw:purchase-onboarding-smoke": "node scripts/openclaw/purchase-onboarding-smoke.mjs",
    "openclaw:basic-package-config": "node scripts/openclaw/build-basic-package-config.mjs",
    "openclaw:growth-package-config": "node scripts/openclaw/build-basic-package-config.mjs --growth",
    "openclaw:pro-package-config": "node scripts/openclaw/build-basic-package-config.mjs --pro",
    "audit:seo-conversion": "node scripts/seo-conversion-audit.mjs --markdown",
    "launch:external-blockers": "node scripts/launch-external-blockers-check.mjs",
    "verify:production-security": "node scripts/verify-production-security.mjs",
    "load-test:leads": "node scripts/load-test-lead-submissions.mjs",
    "cloudflare:check": "node scripts/configure-canonical-www.mjs --check",
    "cloudflare:apply-redirect": "node scripts/configure-canonical-www.mjs --apply-cloudflare-redirect",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "base44:automation-quarantine-audit": "node scripts/base44/audit-automation-quarantine-targets.mjs"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.30",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.84.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^11.16.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "wrangler": "^4.93.0"
  }
}
