# ClientSurge Assurance Node configuration
# Installed to /etc/clientsurge-assurance/assurance.env with mode 0600.

CLIENTSURGE_APP_ID=69dc4a79656fdba136d413d3
CLIENTSURGE_BASE_URL=https://clientsurgesystems.com
CLIENTSURGE_GITHUB_REPOSITORY=stellaragencyai/clientsurge-systems
CLIENTSURGE_GITHUB_WORKFLOW=base44-auto-publish.yml

# Fine-grained GitHub token: repository access only, Actions read-only.
# Required only for clientsurge-release-assurance.timer.
CLIENTSURGE_GITHUB_TOKEN=

# Use a dedicated ClientSurge operations bot/chat, not the Bybit trading bot.
CLIENTSURGE_TELEGRAM_BOT_TOKEN=
CLIENTSURGE_TELEGRAM_CHAT_ID=

CLIENTSURGE_EXPECT_STRIPE_MODE=live
CLIENTSURGE_CHECKOUT_PACKAGE=growth_system
CLIENTSURGE_HTTP_TIMEOUT_SECONDS=20
CLIENTSURGE_SLOW_WARNING_MS=4000
CLIENTSURGE_SLOW_CRITICAL_MS=10000
CLIENTSURGE_SSL_WARNING_DAYS=21
CLIENTSURGE_SSL_CRITICAL_DAYS=7
CLIENTSURGE_FAILURE_THRESHOLD=2
CLIENTSURGE_ALERT_REPEAT_HOURS=6

# These paths match systemd StateDirectory/RuntimeDirectory.
CLIENTSURGE_STATE_DIR=/var/lib/clientsurge-assurance
CLIENTSURGE_RUNTIME_DIR=/run/clientsurge-assurance
